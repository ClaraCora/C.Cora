<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 控制中心磁贴要 load/启停 NETunnelProviderManager，需与主 App / NE 同样的网络扩展权限。
	     不放 App Group：朋友的描述文件没授权 App Group，带上反而会让本扩展签名/安装失败→磁贴不加载。
	     VPN 配置由 loadAllFromPreferences 按 App 维度读取，不依赖 App Group。 -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
</dict>
</plist>
