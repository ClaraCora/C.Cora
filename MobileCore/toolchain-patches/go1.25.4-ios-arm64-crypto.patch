+//go:build arm64 && ios
+
+package cpu
+
+func osInit() {
+	// Go 1.25.4 leaves CPU feature detection empty for GOOS=ios. MiClash
+	// targets iOS 18+ devices, which are expected to provide these instructions.
+	ARM64.HasAES = true
+	ARM64.HasPMULL = true
+}
