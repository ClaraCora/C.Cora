diff --git a/tunnel/ios_update_block_test.go b/tunnel/ios_update_block_test.go
new file mode 100644
--- /dev/null
+++ b/tunnel/ios_update_block_test.go
@@ -0,0 +1,61 @@
+package tunnel
+
+import (
+	"errors"
+	"net/netip"
+	"testing"
+
+	"github.com/metacubex/mihomo/component/iosupdate"
+	"github.com/metacubex/mihomo/component/resolver"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func TestIOSUpdateBlockPrecedesAllModesAndSpecialProxy(t *testing.T) {
+	oldProxies, oldMode := proxies, mode
+	t.Cleanup(func() { proxies, mode = oldProxies, oldMode; iosupdate.Stop() })
+	proxies = map[string]C.Proxy{}
+	iosupdate.Begin(1, "tunnel", true)
+	for _, selectedMode := range []TunnelMode{Rule, Global, Direct} {
+		mode = selectedMode
+		for _, metadata := range []*C.Metadata{
+			{Host: "GDMF.APPLE.COM."},
+			{Host: "other.example", SniffHost: "mesu.apple.com", SpecialProxy: "missing"},
+		} {
+			proxy, _, err := resolveMetadata(metadata)
+			if !errors.Is(err, iosupdate.ErrBlocked) || proxy != nil {
+				t.Fatalf("mode %v bypassed rejection: %v", mode, err)
+			}
+		}
+	}
+	// Unknown IPs and unrelated names must follow their original routing path.
+	for _, host := range []string{"", "x.mesu.apple.com", "gdmf-ados.apple.com"} {
+		_, _, err := resolveMetadata(&C.Metadata{Host: host, SpecialProxy: "missing"})
+		if err == nil || errors.Is(err, iosupdate.ErrBlocked) {
+			t.Fatal("overblocked unrelated connection")
+		}
+	}
+	iosupdate.Configure("off", false)
+	if _, _, err := resolveMetadata(&C.Metadata{Host: "mesu.apple.com", SpecialProxy: "missing"}); err == nil {
+		t.Fatal("disabled policy overrode SpecialProxy")
+	}
+}
+
+func TestIOSUpdateBlockAfterFakeIPRecovery(t *testing.T) {
+	preserveReservedSyntheticIPTestState(t)
+	oldProxies := proxies
+	t.Cleanup(func() { proxies = oldProxies; iosupdate.Stop() })
+	proxies = map[string]C.Proxy{}
+	ip := netip.MustParseAddr("198.18.0.2")
+	resolver.DefaultHostMapper = &reservedSyntheticIPTestEnhancer{
+		hosts: map[netip.Addr]string{ip: "mesu.apple.com"}, fakeIPs: map[netip.Addr]bool{ip: true}, fakeIPEnabled: true,
+	}
+	iosupdate.Begin(2, "fakeip", true)
+	metadata := &C.Metadata{DstIP: ip}
+	if err := preHandleMetadata(metadata); err != nil {
+		t.Fatal(err)
+	}
+	proxy, _, err := resolveMetadata(metadata)
+	if !errors.Is(err, iosupdate.ErrBlocked) || proxy != nil || metadata.Host != "mesu.apple.com" {
+		t.Fatal("cached Fake-IP mapping bypassed policy")
+	}
+}
