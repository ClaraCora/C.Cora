+++ b/dns/ios_update_block_test.go
@@ -0,0 +1,50 @@
+package dns
+
+import (
+	"context"
+	"testing"
+
+	"github.com/metacubex/mihomo/component/iosupdate"
+	icontext "github.com/metacubex/mihomo/context"
+	D "github.com/miekg/dns"
+)
+
+func TestIOSUpdateBlockPrecedesHandlerForEveryQueryType(t *testing.T) {
+	iosupdate.Begin(1, "dns", true)
+	defer iosupdate.Stop()
+	calls := 0
+	s := &Service{handler: func(_ *icontext.DNSContext, msg *D.Msg) (*D.Msg, error) {
+		calls++ // This is the entry to Hosts/cache/Fake-IP/upstream middleware.
+		return new(D.Msg).SetReply(msg), nil
+	}}
+	for _, qtype := range []uint16{D.TypeA, D.TypeAAAA, D.TypeHTTPS, D.TypeSVCB, D.TypeTXT, D.TypeANY} {
+		request := new(D.Msg).SetQuestion("MeSu.Apple.Com.", qtype)
+		request.SetEdns0(4096, true)
+		response, err := s.ServeMsg(context.Background(), request)
+		if err != nil || response.Rcode != D.RcodeRefused || response.Id != request.Id || response.Question[0] != request.Question[0] || len(response.Answer) != 0 || response.IsEdns0() == nil {
+			t.Fatalf("invalid refusal for %d: %v, %v", qtype, response, err)
+		}
+	}
+	if calls != 0 || iosupdate.Status().Domains[1].DNSRefused != 6 {
+		t.Fatal("blocked DNS reached middleware or lost count")
+	}
+	for _, host := range []string{"example.com.", "x.mesu.apple.com.", "gdmf-ados.apple.com."} {
+		_, _ = s.ServeMsg(context.Background(), new(D.Msg).SetQuestion(host, D.TypeA))
+	}
+	if calls != 3 {
+		t.Fatal("normal queries overblocked")
+	}
+	iosupdate.Configure("off", false)
+	_, _ = s.ServeMsg(context.Background(), new(D.Msg).SetQuestion("mesu.apple.com.", D.TypeA))
+	if calls != 4 {
+		t.Fatal("disabled policy did not restore middleware")
+	}
+}
+
+func TestIOSUpdateBlockDoesNotBypassEmptyQuestionValidation(t *testing.T) {
+	iosupdate.Begin(2, "dns", true)
+	defer iosupdate.Stop()
+	if _, err := (&Service{}).ServeMsg(context.Background(), new(D.Msg)); err == nil {
+		t.Fatal("accepted empty DNS request")
+	}
+}
