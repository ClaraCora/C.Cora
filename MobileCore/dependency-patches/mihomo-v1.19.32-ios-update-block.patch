new file mode 100644
--- /dev/null
+++ b/component/iosupdate/policy.go
@@ -0,0 +1,149 @@
+// Package iosupdate implements Cora's narrowly scoped, session-owned update
+// catalog policy. It has no timers, request log, DNS/IP cache or packet hooks.
+package iosupdate
+
+import (
+	"errors"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+var domains = [2]string{"gdmf.apple.com", "mesu.apple.com"}
+
+var ErrBlocked = errors.New("iOS update catalog connection refused")
+
+type DomainStats struct {
+	Domain              string `json:"domain"`
+	DNSRefused          uint64 `json:"dnsRefused"`
+	ConnectionsRejected uint64 `json:"connectionsRejected"`
+	LastHitAt           int64  `json:"lastHitAt"`
+}
+
+type Snapshot struct {
+	Session                 uint64         `json:"session"`
+	ConfigurationID         string         `json:"configurationID"`
+	ConfigurationGeneration uint64         `json:"configurationGeneration"`
+	Revision                uint64         `json:"revision"`
+	Active                  bool           `json:"active"`
+	Enabled                 bool           `json:"enabled"`
+	Domains                 [2]DomainStats `json:"domains"`
+}
+
+var state struct {
+	sync.Mutex
+	fastEnabled atomic.Bool
+	fastSession atomic.Uint64
+	snapshot    Snapshot
+}
+
+// Matches is deliberately exact. Unknown IPs, subdomains and other Apple
+// services are never inferred to be update traffic.
+func Matches(host string) bool { return domainIndex(host) >= 0 }
+
+func domainIndex(host string) int {
+	host = strings.TrimRight(host, ".")
+	for i, domain := range domains {
+		if strings.EqualFold(host, domain) {
+			return i
+		}
+	}
+	return -1
+}
+
+func emptyDomains() (result [2]DomainStats) {
+	for i, domain := range domains {
+		result[i].Domain = domain
+	}
+	return
+}
+
+// Begin must run before DNS/listeners resume. Reconfiguration keeps the
+// session's counts; only a real new session or an explicit reset clears them.
+func Begin(session uint64, id string, enabled bool) {
+	state.Lock()
+	defer state.Unlock()
+	state.snapshot = Snapshot{Session: session, ConfigurationID: id,
+		ConfigurationGeneration: 1, Revision: 1, Active: true,
+		Enabled: enabled, Domains: emptyDomains()}
+	state.fastSession.Store(session)
+	state.fastEnabled.Store(enabled)
+}
+
+func Configure(id string, enabled bool) bool {
+	state.Lock()
+	defer state.Unlock()
+	if !state.snapshot.Active {
+		return false
+	}
+	if state.snapshot.ConfigurationID != id || state.snapshot.Enabled != enabled {
+		state.snapshot.ConfigurationID = id
+		state.snapshot.Enabled = enabled
+		state.snapshot.ConfigurationGeneration++
+		state.snapshot.Revision++
+	}
+	state.fastEnabled.Store(enabled)
+	return true
+}
+
+func Stop() {
+	state.Lock()
+	defer state.Unlock()
+	state.fastEnabled.Store(false)
+	state.fastSession.Store(0)
+	state.snapshot.Active = false
+	state.snapshot.Enabled = false
+	state.snapshot.ConfigurationGeneration++
+	state.snapshot.Revision++
+	state.snapshot.Domains = emptyDomains()
+}
+
+func Status() Snapshot {
+	state.Lock()
+	defer state.Unlock()
+	snapshot := state.snapshot
+	// Also produce the fixed domain list before the first tunnel starts.
+	if snapshot.Domains[0].Domain == "" {
+		snapshot.Domains = emptyDomains()
+	}
+	return snapshot
+}
+
+func ResetStats() {
+	state.Lock()
+	defer state.Unlock()
+	state.snapshot.Domains = emptyDomains()
+	state.snapshot.Revision++
+}
+
+func RejectDNS(host string) bool                   { return record(host, "", true) }
+func RejectConnection(host, sniffHost string) bool { return record(host, sniffHost, false) }
+
+func record(host, alternate string, dns bool) bool {
+	session := state.fastSession.Load()
+	if !state.fastEnabled.Load() {
+		return false
+	}
+	i := domainIndex(host)
+	if i < 0 && alternate != "" {
+		i = domainIndex(alternate)
+	}
+	if i < 0 {
+		return false
+	}
+	state.Lock()
+	defer state.Unlock()
+	if session == 0 || state.snapshot.Session != session || !state.snapshot.Active || !state.snapshot.Enabled {
+		return false
+	}
+	entry := &state.snapshot.Domains[i]
+	if dns {
+		entry.DNSRefused++
+	} else {
+		entry.ConnectionsRejected++
+	}
+	entry.LastHitAt = time.Now().UnixMilli()
+	state.snapshot.Revision++
+	return true
+}
diff --git a/component/iosupdate/policy_test.go b/component/iosupdate/policy_test.go
new file mode 100644
--- /dev/null
+++ b/component/iosupdate/policy_test.go
@@ -0,0 +1,119 @@
+package iosupdate
+
+import (
+	"sync"
+	"testing"
+)
+
+func TestExactDomainsAndSessionLifecycle(t *testing.T) {
+	Begin(42, "a", true)
+	defer Stop()
+	for _, host := range []string{"gdmf.apple.com", "MESU.APPLE.COM.", "GdMf.ApPlE.CoM."} {
+		if !RejectDNS(host) {
+			t.Fatalf("did not reject %q", host)
+		}
+	}
+	for _, host := range []string{"", "17.1.2.3", "apple.com", "x.mesu.apple.com", "mesu.apple.com.evil", "gdmf-ados.apple.com", " mesu.apple.com"} {
+		if RejectDNS(host) || RejectConnection(host, "") {
+			t.Fatalf("overblocked %q", host)
+		}
+	}
+	if !RejectConnection("unrelated.example", "MESU.APPLE.COM.") {
+		t.Fatal("sniff host bypass")
+	}
+	s := Status()
+	if s.Session != 42 || s.Domains[0].DNSRefused != 2 || s.Domains[1].DNSRefused != 1 || s.Domains[1].ConnectionsRejected != 1 || s.Domains[1].LastHitAt == 0 {
+		t.Fatalf("bad stats: %+v", s)
+	}
+	Configure("b", false)
+	if RejectDNS("mesu.apple.com") {
+		t.Fatal("disabled policy rejected")
+	}
+	Configure("c", true)
+	if Status().Domains[0].DNSRefused != 2 {
+		t.Fatal("hot toggle reset stats")
+	}
+	ResetStats()
+	if !Status().Enabled || Status().Domains[0].DNSRefused != 0 {
+		t.Fatal("reset disabled policy")
+	}
+	Stop()
+	if RejectDNS("mesu.apple.com") || Configure("d", true) || Status().Active {
+		t.Fatal("stopped runtime accepted work")
+	}
+	Begin(43, "e", false)
+	if Status().Session != 43 || Status().Domains[1].ConnectionsRejected != 0 {
+		t.Fatal("session retained counters")
+	}
+}
+
+func TestConcurrentCountersAndReset(t *testing.T) {
+	Begin(44, "concurrent", true)
+	defer Stop()
+	var workers sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			for j := 0; j < 1000; j++ {
+				RejectDNS("mesu.apple.com")
+				RejectConnection("gdmf.apple.com", "mesu.apple.com")
+				_ = Status()
+			}
+		}()
+	}
+	workers.Wait()
+	if s := Status(); s.Domains[1].DNSRefused != 8000 || s.Domains[0].ConnectionsRejected != 8000 || s.Domains[1].ConnectionsRejected != 0 {
+		t.Fatalf("lost or duplicate hits: %+v", s)
+	}
+	workers.Add(2)
+	go func() {
+		defer workers.Done()
+		for i := 0; i < 1000; i++ {
+			ResetStats()
+			Configure("toggle", i%2 == 0)
+		}
+	}()
+	go func() {
+		defer workers.Done()
+		for i := 0; i < 1000; i++ {
+			RejectDNS("mesu.apple.com")
+			_ = Status()
+		}
+	}()
+	workers.Wait()
+}
+
+func TestIOSUpdateBlockMatchingDoesNotAllocate(t *testing.T) {
+	Begin(45, "allocations", true)
+	defer Stop()
+	allocations := testing.AllocsPerRun(1000, func() {
+		RejectDNS("www.apple.com.")
+		RejectDNS("MESU.APPLE.COM.")
+		RejectConnection("", "gdmf.apple.com")
+	})
+	if allocations != 0 {
+		t.Fatalf("matching allocated %.2f objects per request batch", allocations)
+	}
+}
+
+func BenchmarkIOSUpdateBlock(b *testing.B) {
+	for _, enabled := range []bool{false, true} {
+		name := "disabled"
+		if enabled {
+			name = "enabled"
+		}
+		b.Run(name, func(b *testing.B) {
+			Begin(46, "benchmark", enabled)
+			defer Stop()
+			for _, domain := range []string{"www.example.com.", "mesu.apple.com."} {
+				b.Run(domain, func(b *testing.B) {
+					b.ReportAllocs()
+					for i := 0; i < b.N; i++ {
+						RejectDNS(domain)
+					}
+				})
+			}
+		})
+	}
+}
