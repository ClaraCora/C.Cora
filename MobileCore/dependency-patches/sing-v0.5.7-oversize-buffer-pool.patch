@@ -0,0 +1,79 @@
+package buf
+
+import (
+	"testing"
+)
+
+func TestNewSizeOversizePoolBoundary(t *testing.T) {
+	tests := []struct {
+		size        int
+		wantCap     int
+		wantManaged bool
+	}{
+		{size: 65535, wantCap: 65536, wantManaged: true},
+		{size: 65536, wantCap: 65536, wantManaged: true},
+		{size: 65537, wantCap: maxPooledSize, wantManaged: true},
+		{size: 65551, wantCap: maxPooledSize, wantManaged: true},
+		{size: 65552, wantCap: maxPooledSize, wantManaged: true},
+		{size: 65553, wantCap: 65553, wantManaged: false},
+	}
+
+	for _, test := range tests {
+		buffer := NewSize(test.size)
+		if got := len(buffer.data); got != test.size {
+			t.Errorf("NewSize(%d) len = %d, want %d", test.size, got, test.size)
+		}
+		if got := cap(buffer.data); got != test.wantCap {
+			t.Errorf("NewSize(%d) cap = %d, want %d", test.size, got, test.wantCap)
+		}
+		if buffer.managed != test.wantManaged {
+			t.Errorf("NewSize(%d) managed = %v, want %v", test.size, buffer.managed, test.wantManaged)
+		}
+		buffer.Release()
+		if test.wantManaged && buffer.data != nil {
+			t.Errorf("NewSize(%d) retained data after Release", test.size)
+		}
+		if !test.wantManaged && buffer.data == nil {
+			t.Errorf("NewSize(%d) unexpectedly released unmanaged data", test.size)
+		}
+	}
+}
+
+func TestAllocatorOversizePoolBoundary(t *testing.T) {
+	tests := []struct {
+		size    int
+		wantCap int
+	}{
+		{size: 65536, wantCap: 65536},
+		{size: 65537, wantCap: maxPooledSize},
+		{size: 65551, wantCap: maxPooledSize},
+		{size: 65552, wantCap: maxPooledSize},
+	}
+	for _, test := range tests {
+		data := DefaultAllocator.Get(test.size)
+		if got := len(data); got != test.size {
+			t.Errorf("Get(%d) len = %d, want %d", test.size, got, test.size)
+		}
+		if got := cap(data); got != test.wantCap {
+			t.Errorf("Get(%d) cap = %d, want %d", test.size, got, test.wantCap)
+		}
+		if err := DefaultAllocator.Put(data); err != nil {
+			t.Errorf("Put(Get(%d)) failed: %v", test.size, err)
+		}
+	}
+
+	if data := DefaultAllocator.Get(maxPooledSize + 1); data != nil {
+		t.Fatal("allocator accepted a size above the dedicated bucket")
+	}
+	if err := DefaultAllocator.Put(make([]byte, maxPooledSize-1)); err == nil {
+		t.Fatal("allocator accepted a non-bucket capacity")
+	}
+}
+
+func BenchmarkNewSize65551(b *testing.B) {
+	b.ReportAllocs()
+	for i := 0; i < b.N; i++ {
+		buffer := NewSize(65551)
+		buffer.Release()
+	}
+}
