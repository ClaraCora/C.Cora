--- /dev/null
+++ b/pkg/tcpip/link/qdisc/memory_diagnostics_test.go
@@ -0,0 +1,30 @@
+package qdisc
+
+import (
+	"testing"
+
+	"github.com/metacubex/gvisor/pkg/buffer"
+	"github.com/metacubex/gvisor/pkg/tcpip/stack"
+)
+
+func TestDiagnosticQueuedBytesAcrossWraparound(t *testing.T) {
+	var queue PacketBufferCircularList
+	queue.Init(3)
+	for _, size := range []int{10, 20, 30} {
+		queue.PushBack(stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(make([]byte, size))}))
+	}
+	if queue.QueuedBytes() != 60 || queue.Length() != 3 {
+		t.Fatal("incorrect full queue")
+	}
+	queue.RemoveFront().DecRef()
+	queue.PushBack(stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(make([]byte, 40))}))
+	if queue.QueuedBytes() != 90 || queue.PeekFront().Size() != 20 {
+		t.Fatal("sample changed queue ordering or missed wraparound")
+	}
+	for p := queue.RemoveFront(); p != nil; p = queue.RemoveFront() {
+		p.DecRef()
+	}
+	if queue.QueuedBytes() != 0 {
+		t.Fatal("stale bytes after drain")
+	}
+}
