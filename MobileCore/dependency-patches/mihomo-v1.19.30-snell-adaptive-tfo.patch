+func TestAdaptiveTFOProbeWaitsForProtocolConfirmation(t *testing.T) {
+	useTestAdaptiveTFOCache(t)
+	physical := &testConn{}
+	tfoCalls := 0
+	tcpCalls := 0
+	owner := &tfoConn{}
+	conn, err := owner.dialAdaptiveTFO(context.Background(), "pdp_ip0", "192.0.2.1:443", []byte("complete raw write"),
+		func(context.Context, []byte) (net.Conn, error) {
+			tfoCalls++
+			return physical, nil
+		},
+		func(context.Context, []byte) (net.Conn, error) {
+			tcpCalls++
+			return &testConn{}, nil
+		})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if conn != physical || tfoCalls != 1 || tcpCalls != 0 {
+		t.Fatalf("connection=%T, TFO calls=%d, TCP calls=%d", conn, tfoCalls, tcpCalls)
+	}
+	if physical.readCalls != 0 {
+		t.Fatalf("dialer read %d raw response bytes before Snell confirmation", physical.readCalls)
+	}
+	probe := AdaptiveTFOProbeForConn(owner)
+	if probe == nil {
+		t.Fatal("initial TFO connection did not expose its protocol probe")
+	}
+	probe.ConfirmTFO()
+	if AdaptiveTFOProbeForConn(owner) != nil {
+		t.Fatal("completed probe remained active")
+	}
+
+	second := &tfoConn{}
+	_, err = second.dialAdaptiveTFO(context.Background(), "pdp_ip0", "192.0.2.1:443", []byte("next write"),
+		func(context.Context, []byte) (net.Conn, error) {
+			tfoCalls++
+			return &testConn{}, nil
+		},
+		func(context.Context, []byte) (net.Conn, error) {
+			tcpCalls++
+			return &testConn{}, nil
+		})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if tfoCalls != 2 || tcpCalls != 0 || AdaptiveTFOProbeForConn(second) != nil {
+		t.Fatalf("confirmed entrance: TFO calls=%d, TCP calls=%d, probe=%v", tfoCalls, tcpCalls, AdaptiveTFOProbeForConn(second))
+	}
+}
