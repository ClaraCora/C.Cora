+func dialTFO(ctx context.Context, netDialer net.Dialer, network, address, interfaceName string, adaptive bool) (net.Conn, error) {
+	ctx, cancel := context.WithTimeout(ctx, DefaultTCPTimeout)
+	tfoDialer := tfo.Dialer{Dialer: netDialer, DisableTFO: false}
+	tfoDial := func(ctx context.Context, earlyData []byte) (net.Conn, error) {
+		return tfoDialer.DialContext(ctx, network, address, earlyData)
+	}
+	tcpDial := func(ctx context.Context, earlyData []byte) (net.Conn, error) {
+		return dialTCPWithEarlyData(ctx, netDialer, network, address, earlyData)
+	}
+	dialFn := tfoDial
+	if adaptive {
+		dialFn = func(ctx context.Context, earlyData []byte) (net.Conn, error) {
+			return dialAdaptiveTFO(ctx, interfaceName, address, earlyData, tfoDial, tcpDial)
+		}
+	}
 	return &tfoConn{
 		dialed: make(chan bool, 1),
 		cancel: cancel,
 		ctx:    ctx,
-		dialFn: func(ctx context.Context, earlyData []byte) (net.Conn, error) {
-			return dialer.DialContext(ctx, network, address, earlyData)
-		},
+		dialFn: dialFn,
 	}, nil
 }
+
+type earlyDialFunc func(context.Context, []byte) (net.Conn, error)
+
+func dialAdaptiveTFO(ctx context.Context, interfaceName, address string, earlyData []byte,
+	tfoDial, tcpDial earlyDialFunc) (net.Conn, error) {
+	attempt := adaptiveTFOStates.decide(interfaceName, address)
+	if attempt.decision == adaptiveTFOUseTCP {
+		return tcpDial(ctx, earlyData)
+	}
+
+	probeCtx, cancel := context.WithTimeout(ctx, adaptiveTFOProbeTimeout)
+	conn, tfoErr := tfoDial(probeCtx, earlyData)
+	cancel()
+	if tfoErr == nil {
+		logAdaptiveTFOTransition(adaptiveTFOStates.record(attempt, true, false), interfaceName, address, nil)
+		return conn, nil
+	}
+
+	conn, tcpErr := tcpDial(ctx, earlyData)
+	logAdaptiveTFOTransition(adaptiveTFOStates.record(attempt, false, tcpErr == nil), interfaceName, address, tfoErr)
+	if tcpErr == nil {
+		return conn, nil
+	}
+	return nil, errors.Join(tfoErr, tcpErr)
+}
+
+func dialTCPWithEarlyData(ctx context.Context, netDialer net.Dialer, network, address string,
+	earlyData []byte) (net.Conn, error) {
+	conn, err := netDialer.DialContext(ctx, network, address)
+	if err != nil {
+		return nil, err
+	}
+	if len(earlyData) == 0 {
+		return conn, nil
+	}
+	if deadline, ok := ctx.Deadline(); ok {
+		if err := conn.SetWriteDeadline(deadline); err != nil {
+			_ = conn.Close()
+			return nil, err
+		}
+	}
+	written := 0
+	for written < len(earlyData) {
+		n, writeErr := conn.Write(earlyData[written:])
+		written += n
+		if writeErr != nil {
+			_ = conn.Close()
+			return nil, writeErr
+		}
+		if n == 0 {
+			_ = conn.Close()
+			return nil, io.ErrNoProgress
+		}
+	}
+	_ = conn.SetWriteDeadline(time.Time{})
+	return conn, nil
+}
+
+func logAdaptiveTFOTransition(transition adaptiveTFOTransition, interfaceName, address string, tfoErr error) {
+	switch transition {
+	case adaptiveTFOFirstSuccess:
+		log.Infoln("Snell 自适应 TFO：入口 %s（接口 %s）TFO 可用", address, interfaceName)
+	case adaptiveTFOFallback:
+		log.Warnln("Snell 自适应 TFO：入口 %s（接口 %s）TFO 失败，已仅对该入口改用普通 TCP，%s 后重试：%v",
+			address, interfaceName, adaptiveTFOCooldown, tfoErr)
+	case adaptiveTFORecovered:
+		log.Infoln("Snell 自适应 TFO：入口 %s（接口 %s）TFO 已恢复", address, interfaceName)
+	}
+}
