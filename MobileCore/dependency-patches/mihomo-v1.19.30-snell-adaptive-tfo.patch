+func TestAdaptiveTFOHeldFallbackSurvivesCachePressure(t *testing.T) {
+	cache := useTestAdaptiveTFOCache(t)
+	adaptiveTFOHoldUntilNetworkChange.Store(true)
+	held := cache.decide("pdp_ip0", "198.18.0.1:443")
+	cache.record(held, false, true)
+	for index := 1; index < adaptiveTFOMaxEntries; index++ {
+		attempt := cache.decide("pdp_ip0", fmt.Sprintf("198.18.1.%d:443", index))
+		cache.record(attempt, true, false)
+	}
+	for index := 0; index < 32; index++ {
+		attempt := cache.decide("pdp_ip0", fmt.Sprintf("198.18.2.%d:443", index))
+		if attempt.decision != adaptiveTFOProbe {
+			t.Fatalf("pressure decision %d=%v, want probe", index, attempt.decision)
+		}
+		cache.record(attempt, true, false)
+	}
+
+	cache.mu.Lock()
+	entry, exists := cache.entries[held.key]
+	count := len(cache.entries)
+	cache.mu.Unlock()
+	if !exists || entry.state != adaptiveTFOIncompatible {
+		t.Fatal("held fallback was evicted under cache pressure")
+	}
+	if count != adaptiveTFOMaxEntries {
+		t.Fatalf("cache entries=%d, want %d", count, adaptiveTFOMaxEntries)
+	}
+}
