+	source, ok := stream.Conn.(*snellSourceConn)
+	if !ok {
+		return nil
+	}
+	probe := source.probe
+	if probe == nil {
+		dialerProbe := dialer.AdaptiveTFOProbeForConn(source.source)
+		if dialerProbe == nil {
+			return nil
+		}
+		probe = dialerProbe
+	}
+	return &snellAdaptiveTFOContext{
+		probe: probe, isFallback: source.isFallback, tfoError: source.tfoError,
+	}
+}
