+func useTestAdaptiveTFOCache(t *testing.T) *adaptiveTFOCache {
+	t.Helper()
+	previous := adaptiveTFOStates
+	previousHold := adaptiveTFOHoldUntilNetworkChange.Load()
+	adaptiveTFOHoldUntilNetworkChange.Store(false)
+	cache := newAdaptiveTFOCache()
+	adaptiveTFOStates = cache
+	t.Cleanup(func() {
+		adaptiveTFOStates = previous
+		adaptiveTFOHoldUntilNetworkChange.Store(previousHold)
+	})
+	return cache
+}
+
+type testConn struct {
+	mu        sync.Mutex
+	readCalls int
+	closed    bool
+}
+
+func (c *testConn) Read([]byte) (int, error) {
+	c.mu.Lock()
+	c.readCalls++
+	c.mu.Unlock()
+	return 0, io.EOF
+}
+
+func (c *testConn) Write(buffer []byte) (int, error) { return len(buffer), nil }
+func (c *testConn) LocalAddr() net.Addr              { return &net.TCPAddr{} }
+func (c *testConn) RemoteAddr() net.Addr             { return &net.TCPAddr{} }
+func (c *testConn) SetDeadline(time.Time) error      { return nil }
+func (c *testConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *testConn) SetWriteDeadline(time.Time) error { return nil }
+func (c *testConn) Close() error {
+	c.mu.Lock()
+	c.closed = true
+	c.mu.Unlock()
+	return nil
+}
+
+func TestTFOConnClosesDialThatReturnsAfterCancellation(t *testing.T) {
+	started := make(chan struct{})
+	release := make(chan struct{})
+	physical := &testConn{}
+	ctx, cancel := context.WithCancel(context.Background())
+	owner := &tfoConn{
+		dialed: make(chan bool, 1),
+		cancel: cancel,
+		ctx:    ctx,
+		dialFn: func(context.Context, []byte) (net.Conn, error) {
+			close(started)
+			<-release
+			return physical, nil
+		},
+	}
+	writeDone := make(chan error, 1)
+	go func() {
+		_, err := owner.Write([]byte("probe"))
+		writeDone <- err
+	}()
+	<-started
+	if err := owner.Close(); err != nil {
+		t.Fatal(err)
+	}
+	close(release)
+	if err := <-writeDone; err == nil {
+		t.Fatal("late dial was published after the lazy connection was closed")
+	}
+	physical.mu.Lock()
+	physicalClosed := physical.closed
+	physical.mu.Unlock()
+	if !physicalClosed {
+		t.Fatal("physical connection returned after cancellation was not closed")
+	}
+	conn, closed, _ := owner.state()
+	if !closed || conn != nil {
+		t.Fatalf("lazy connection state: closed=%v conn=%v", closed, conn)
+	}
+}
+
+func TestAdaptiveTFOProbeWaitsForProtocolConfirmation(t *testing.T) {
+	useTestAdaptiveTFOCache(t)
+	physical := &testConn{}
+	tfoCalls := 0
+	tcpCalls := 0
+	owner := &tfoConn{}
+	owner.configureAdaptiveTFO("pdp_ip0", "192.0.2.1:443",
+		func(context.Context, []byte) (net.Conn, error) {
+			tfoCalls++
+			if tfoCalls == 1 {
+				return physical, nil
+			}
+			return &testConn{}, nil
+		},
+		func(context.Context, []byte) (net.Conn, error) {
+			tcpCalls++
+			return &testConn{}, nil
+		})
+	probe := AdaptiveTFOProbeForConn(owner)
+	if probe == nil {
+		t.Fatal("unknown entrance did not expose its protocol probe before the first write")
+	}
+	conn, err := owner.dialFn(context.Background(), []byte("complete raw write"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if conn != physical || tfoCalls != 1 || tcpCalls != 0 {
+		t.Fatalf("connection=%T, TFO calls=%d, TCP calls=%d", conn, tfoCalls, tcpCalls)
+	}
+	if physical.readCalls != 0 {
+		t.Fatalf("dialer read %d raw response bytes before Snell confirmation", physical.readCalls)
+	}
+	verification, err := probe.DialTFO(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = verification.Write([]byte("encrypted ping record")); err != nil {
+		t.Fatal(err)
+	}
+	_ = verification.Close()
+	if tfoCalls != 2 {
+		t.Fatalf("post-cookie TFO verification calls=%d, want 2 total", tfoCalls)
+	}
+	probe.ConfirmTFO()
+	if AdaptiveTFOProbeForConn(owner) != nil {
+		t.Fatal("completed probe remained active")
+	}
+
+	second := &tfoConn{}
+	second.configureAdaptiveTFO("pdp_ip0", "192.0.2.1:443",
+		func(context.Context, []byte) (net.Conn, error) {
+			tfoCalls++
+			return &testConn{}, nil
+		},
+		func(context.Context, []byte) (net.Conn, error) {
+			tcpCalls++
+			return &testConn{}, nil
+		})
+	_, err = second.dialFn(context.Background(), []byte("next write"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if tfoCalls != 3 || tcpCalls != 0 || AdaptiveTFOProbeForConn(second) != nil {
+		t.Fatalf("confirmed entrance: TFO calls=%d, TCP calls=%d, probe=%v", tfoCalls, tcpCalls, AdaptiveTFOProbeForConn(second))
+	}
+}
+
+func TestAdaptiveTFOFallbackIsFreshAndCachesOnlyAfterConfirmation(t *testing.T) {
+	useTestAdaptiveTFOCache(t)
+	tfoCalls := 0
+	tcpCalls := 0
+	var fallbackEarlyData []byte
+	owner := &tfoConn{}
+	owner.configureAdaptiveTFO("pdp_ip0", "192.0.2.2:443",
+		func(context.Context, []byte) (net.Conn, error) {
+			tfoCalls++
+			return &testConn{}, nil
+		},
+		func(_ context.Context, earlyData []byte) (net.Conn, error) {
+			tcpCalls++
+			fallbackEarlyData = append([]byte(nil), earlyData...)
+			return &testConn{}, nil
+		})
+	_, err := owner.dialFn(context.Background(), []byte("encrypted TFO payload"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	probe := AdaptiveTFOProbeForConn(owner)
+	if probe == nil {
+		t.Fatal("missing probe")
+	}
+	if _, err = probe.DialFallback(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if len(fallbackEarlyData) != 0 {
+		t.Fatalf("fallback replayed %d raw bytes instead of rebuilding the protocol", len(fallbackEarlyData))
+	}
+	if got := adaptiveTFOStates.decide("pdp_ip0", "192.0.2.2:443").decision; got != adaptiveTFOUseTCP {
+		t.Fatalf("concurrent decision before confirmation=%v, want ordinary TCP while probing", got)
+	}
+	probe.ConfirmFallback(context.DeadlineExceeded)
+
+	second := &tfoConn{}
+	second.configureAdaptiveTFO("pdp_ip0", "192.0.2.2:443",
+		func(context.Context, []byte) (net.Conn, error) {
+			tfoCalls++
+			return &testConn{}, nil
+		},
+		func(context.Context, []byte) (net.Conn, error) {
+			tcpCalls++
+			return &testConn{}, nil
+		})
+	_, err = second.dialFn(context.Background(), []byte("next write"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if tfoCalls != 1 || tcpCalls != 2 || AdaptiveTFOProbeForConn(second) != nil {
+		t.Fatalf("cached fallback: TFO calls=%d, TCP calls=%d, probe=%v", tfoCalls, tcpCalls, AdaptiveTFOProbeForConn(second))
+	}
+}
