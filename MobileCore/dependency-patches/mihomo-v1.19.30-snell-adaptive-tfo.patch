@@ -0,0 +1,314 @@
+package outbound
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/transport/snell"
+)
+
+type adaptiveProbeTrackedConn struct {
+	net.Conn
+	mu     sync.Mutex
+	closed bool
+}
+
+func (c *adaptiveProbeTrackedConn) Close() error {
+	c.mu.Lock()
+	c.closed = true
+	c.mu.Unlock()
+	return c.Conn.Close()
+}
+
+func (c *adaptiveProbeTrackedConn) isClosed() bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.closed
+}
+
+type adaptiveProbeStub struct {
+	confirmationTimeout time.Duration
+	tfo                 net.Conn
+	tfoErr              error
+	tfoDials            int
+	fallback            net.Conn
+	fallbackErr         error
+	fallbackDials       int
+	tfoConfirmed        bool
+	fallbackConfirmed   bool
+	failureConfirmed    bool
+	abandoned           bool
+	abandonReason       error
+}
+
+func (p *adaptiveProbeStub) ConfirmationContext(ctx context.Context) (context.Context, context.CancelFunc) {
+	return context.WithTimeout(ctx, p.confirmationTimeout)
+}
+
+func (p *adaptiveProbeStub) DialTFO(context.Context) (net.Conn, error) {
+	p.tfoDials++
+	return p.tfo, p.tfoErr
+}
+
+func (p *adaptiveProbeStub) DialFallback(context.Context) (net.Conn, error) {
+	p.fallbackDials++
+	return p.fallback, p.fallbackErr
+}
+
+func (p *adaptiveProbeStub) ConfirmTFO()                 { p.tfoConfirmed = true }
+func (p *adaptiveProbeStub) ConfirmFallback(error)       { p.fallbackConfirmed = true }
+func (p *adaptiveProbeStub) ConfirmFailure(error, error) { p.failureConfirmed = true }
+func (p *adaptiveProbeStub) Abandon(reason error) {
+	p.abandoned = true
+	p.abandonReason = reason
+}
+
+func newAdaptiveProbeTestSnell() *Snell {
+	return &Snell{
+		psk:        []byte("test psk"),
+		obfsOption: &simpleObfsOption{},
+		version:    snell.Version4,
+	}
+}
+
+func newAdaptivePingServer(t *testing.T, psk []byte, version int, response *byte,
+	delay ...time.Duration) (*adaptiveProbeTrackedConn, <-chan []byte) {
+	t.Helper()
+	client, server := net.Pipe()
+	request := make(chan []byte, 1)
+	go func() {
+		defer server.Close()
+		stream := snell.ServerStreamConn(server, psk, version)
+		payload := make([]byte, 2)
+		if _, err := io.ReadFull(stream, payload); err != nil {
+			request <- nil
+			return
+		}
+		request <- payload
+		if response != nil {
+			if len(delay) > 0 {
+				time.Sleep(delay[0])
+			}
+			_, _ = stream.Write([]byte{*response})
+		}
+	}()
+	return &adaptiveProbeTrackedConn{Conn: client}, request
+}
+
+func TestFinishAdaptiveTFOProbeUsesTwoDisposablePingConnections(t *testing.T) {
+	s := newAdaptiveProbeTestSnell()
+	pong := byte(snell.CommandPong)
+	warmup, warmupRequest := newAdaptivePingServer(t, s.psk, s.version, &pong)
+	verification, verificationRequest := newAdaptivePingServer(t, s.psk, s.version, &pong)
+	probe := &adaptiveProbeStub{confirmationTimeout: time.Second, tfo: verification}
+
+	if err := s.finishAdaptiveTFOProbe(context.Background(), warmup, probe); err != nil {
+		t.Fatal(err)
+	}
+	if !probe.tfoConfirmed || probe.fallbackConfirmed || probe.failureConfirmed ||
+		probe.tfoDials != 1 || probe.fallbackDials != 0 {
+		t.Fatalf("TFO=%v fallback=%v failure=%v TFO dials=%d fallback dials=%d",
+			probe.tfoConfirmed, probe.fallbackConfirmed, probe.failureConfirmed,
+			probe.tfoDials, probe.fallbackDials)
+	}
+	if !warmup.isClosed() || !verification.isClosed() {
+		t.Fatalf("TFO probe sockets closed: warm-up=%v verification=%v",
+			warmup.isClosed(), verification.isClosed())
+	}
+	for name, request := range map[string]<-chan []byte{
+		"warm-up": warmupRequest, "verification": verificationRequest,
+	} {
+		if got := <-request; !bytes.Equal(got, []byte{snell.Version, snell.CommandPing}) {
+			t.Fatalf("%s probe request=%x, want a standalone Snell Ping", name, got)
+		}
+	}
+}
+
+func TestFinishAdaptiveTFOProbeFallsBackWithFreshPingConnection(t *testing.T) {
+	s := newAdaptiveProbeTestSnell()
+	badResponse := byte(snell.CommandError)
+	failedTFO, tfoRequest := newAdaptivePingServer(t, s.psk, s.version, &badResponse)
+	pong := byte(snell.CommandPong)
+	ordinaryTCP, tcpRequest := newAdaptivePingServer(t, s.psk, s.version, &pong)
+	probe := &adaptiveProbeStub{
+		confirmationTimeout: time.Second,
+		fallback:            ordinaryTCP,
+	}
+
+	if err := s.finishAdaptiveTFOProbe(context.Background(), failedTFO, probe); err != nil {
+		t.Fatal(err)
+	}
+	if probe.tfoConfirmed || !probe.fallbackConfirmed || probe.failureConfirmed || probe.fallbackDials != 1 {
+		t.Fatalf("TFO=%v fallback=%v failure=%v fallback dials=%d",
+			probe.tfoConfirmed, probe.fallbackConfirmed, probe.failureConfirmed, probe.fallbackDials)
+	}
+	if !failedTFO.isClosed() || !ordinaryTCP.isClosed() {
+		t.Fatalf("probe sockets closed: TFO=%v TCP=%v", failedTFO.isClosed(), ordinaryTCP.isClosed())
+	}
+	for name, request := range map[string]<-chan []byte{"TFO": tfoRequest, "TCP": tcpRequest} {
+		if got := <-request; !bytes.Equal(got, []byte{snell.Version, snell.CommandPing}) {
+			t.Fatalf("%s probe request=%x, want Snell Ping", name, got)
+		}
+	}
+}
+
+func TestFinishAdaptiveTFOProbeFallsBackWhenPostCookieTFOFails(t *testing.T) {
+	s := newAdaptiveProbeTestSnell()
+	pong := byte(snell.CommandPong)
+	warmup, _ := newAdaptivePingServer(t, s.psk, s.version, &pong)
+	badResponse := byte(snell.CommandError)
+	verification, _ := newAdaptivePingServer(t, s.psk, s.version, &badResponse)
+	ordinaryTCP, _ := newAdaptivePingServer(t, s.psk, s.version, &pong)
+	probe := &adaptiveProbeStub{
+		confirmationTimeout: time.Second,
+		tfo:                 verification,
+		fallback:            ordinaryTCP,
+	}
+
+	if err := s.finishAdaptiveTFOProbe(context.Background(), warmup, probe); err != nil {
+		t.Fatal(err)
+	}
+	if probe.tfoConfirmed || !probe.fallbackConfirmed || probe.failureConfirmed ||
+		probe.tfoDials != 1 || probe.fallbackDials != 1 {
+		t.Fatalf("TFO=%v fallback=%v failure=%v TFO dials=%d fallback dials=%d",
+			probe.tfoConfirmed, probe.fallbackConfirmed, probe.failureConfirmed,
+			probe.tfoDials, probe.fallbackDials)
+	}
+	if !warmup.isClosed() || !verification.isClosed() || !ordinaryTCP.isClosed() {
+		t.Fatalf("probe sockets closed: warm-up=%v verification=%v TCP=%v",
+			warmup.isClosed(), verification.isClosed(), ordinaryTCP.isClosed())
+	}
+}
+
+func TestFinishAdaptiveTFOProbeGivesOrdinaryTCPTheCallerBudget(t *testing.T) {
+	s := newAdaptiveProbeTestSnell()
+	badResponse := byte(snell.CommandError)
+	failedTFO, _ := newAdaptivePingServer(t, s.psk, s.version, &badResponse)
+	pong := byte(snell.CommandPong)
+	ordinaryTCP, _ := newAdaptivePingServer(t, s.psk, s.version, &pong, 150*time.Millisecond)
+	probe := &adaptiveProbeStub{
+		confirmationTimeout: 25 * time.Millisecond,
+		fallback:            ordinaryTCP,
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+
+	if err := s.finishAdaptiveTFOProbe(ctx, failedTFO, probe); err != nil {
+		t.Fatalf("ordinary TCP incorrectly inherited the short TFO timeout: %v", err)
+	}
+	if !probe.fallbackConfirmed || probe.failureConfirmed {
+		t.Fatalf("fallback=%v failure=%v", probe.fallbackConfirmed, probe.failureConfirmed)
+	}
+}
+
+func TestFinishAdaptiveTFOProbeDoesNotClassifyDoubleFailure(t *testing.T) {
+	s := newAdaptiveProbeTestSnell()
+	wrong := byte(snell.CommandError)
+	failedTFO, _ := newAdaptivePingServer(t, s.psk, s.version, &wrong)
+	failedTCP, _ := newAdaptivePingServer(t, s.psk, s.version, &wrong)
+	probe := &adaptiveProbeStub{
+		confirmationTimeout: time.Second,
+		fallback:            failedTCP,
+	}
+
+	err := s.finishAdaptiveTFOProbe(context.Background(), failedTFO, probe)
+	if err == nil || !probe.failureConfirmed || probe.fallbackConfirmed {
+		t.Fatalf("error=%v failure=%v fallback=%v", err, probe.failureConfirmed, probe.fallbackConfirmed)
+	}
+	if !failedTFO.isClosed() || !failedTCP.isClosed() {
+		t.Fatalf("failed probe sockets closed: TFO=%v TCP=%v", failedTFO.isClosed(), failedTCP.isClosed())
+	}
+}
+
+func TestFinishAdaptiveTFOProbeRespectsCallerCancellation(t *testing.T) {
+	s := newAdaptiveProbeTestSnell()
+	physical, _ := newAdaptivePingServer(t, s.psk, s.version, nil)
+	probe := &adaptiveProbeStub{confirmationTimeout: time.Second}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	err := s.finishAdaptiveTFOProbe(ctx, physical, probe)
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("error=%v, want context.Canceled", err)
+	}
+	if !probe.abandoned || !errors.Is(probe.abandonReason, context.Canceled) || probe.fallbackDials != 0 {
+		t.Fatalf("abandoned=%v reason=%v fallback dials=%d",
+			probe.abandoned, probe.abandonReason, probe.fallbackDials)
+	}
+	if !physical.isClosed() {
+		t.Fatal("canceled TFO probe socket was not closed")
+	}
+}
+
+func TestStreamConnContextTCPDoesNotWaitForTunnelReply(t *testing.T) {
+	for _, reuse := range []bool{false, true} {
+		t.Run(map[bool]string{false: "connect", true: "reuse"}[reuse], func(t *testing.T) {
+			s := newAdaptiveProbeTestSnell()
+			s.reuse = reuse
+			client, server := net.Pipe()
+			request := make(chan []byte, 1)
+			go func() {
+				defer server.Close()
+				stream := snell.ServerStreamConn(server, s.psk, s.version)
+				header := make([]byte, 2)
+				_, _ = io.ReadFull(stream, header)
+				request <- header
+			}()
+
+			ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+			defer cancel()
+			conn, err := s.StreamConnContext(ctx, client, &C.Metadata{DstPort: 443})
+			if err != nil {
+				t.Fatalf("TCP header waited for a destination reply: %v", err)
+			}
+			_ = conn.Close()
+			wantCommand := byte(snell.CommandConnect)
+			if reuse {
+				wantCommand = snell.CommandConnectV2
+			}
+			if got := <-request; !bytes.Equal(got, []byte{snell.Version, wantCommand}) {
+				t.Fatalf("header=%x, want version and command %x", got, wantCommand)
+			}
+		})
+	}
+}
+
+func TestStreamConnContextUDPStillWaitsForImmediateReply(t *testing.T) {
+	s := newAdaptiveProbeTestSnell()
+	client, server := net.Pipe()
+	go func() {
+		defer server.Close()
+		stream := snell.ServerStreamConn(server, s.psk, s.version)
+		header := make([]byte, 3)
+		if _, err := io.ReadFull(stream, header); err == nil {
+			_, _ = stream.Write([]byte{snell.CommandTunnel})
+		}
+	}()
+
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	conn, err := s.StreamConnContext(ctx, client, &C.Metadata{NetWork: C.UDP})
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = conn.Close()
+}
+
+func TestNewSnellMapsVersion5ToVersion4ForProbeAndReuse(t *testing.T) {
+	proxy, err := NewSnell(SnellOption{
+		Name: "v5", Server: "192.0.2.1", Port: 443, Psk: "test", Version: snell.Version5, Reuse: true,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if proxy.version != snell.Version4 || !proxy.reuse {
+		t.Fatalf("version=%d reuse=%v, want v4 transport with reuse", proxy.version, proxy.reuse)
+	}
+}
