+
+func newAdaptiveTFOCache() *adaptiveTFOCache {
+	return &adaptiveTFOCache{
+		entries:    make(map[string]*adaptiveTFOEntry),
+		now:        time.Now,
+		cooldown:   adaptiveTFOCooldown,
+		maxEntries: adaptiveTFOMaxEntries,
