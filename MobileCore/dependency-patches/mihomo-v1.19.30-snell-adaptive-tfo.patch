+func (s *Snell) pingProbeContext(ctx context.Context, raw net.Conn) (err error) {
+	owner := raw
+	defer func() { _ = owner.Close() }()
+
+	stream, err := s.streamConnContext(ctx, raw)
+	if err != nil {
+		return err
+	}
+	owner = stream
+	return pingSnellContext(ctx, stream)
+}
+
+func (s *Snell) finishAdaptiveTFOProbe(ctx context.Context, raw net.Conn,
+	probe snellAdaptiveTFOProbe) error {
+	probeCtx, cancel := probe.ConfirmationContext(ctx)
+	tfoErr := s.pingProbeContext(probeCtx, raw)
+	cancel()
+	if tfoErr == nil {
+		verifyCtx, cancelVerify := probe.ConfirmationContext(ctx)
+		verifyRaw, verifyErr := probe.DialTFO(verifyCtx)
+		if verifyErr == nil {
+			verifyErr = s.pingProbeContext(verifyCtx, verifyRaw)
+		}
+		cancelVerify()
+		if verifyErr == nil {
+			probe.ConfirmTFO()
+			return nil
+		}
+		tfoErr = fmt.Errorf("TFO verification after cookie warm-up: %w", verifyErr)
+	}
+	if ctxErr := ctx.Err(); ctxErr != nil {
+		probe.Abandon(ctxErr)
+		return ctxErr
+	}
+
+	fallbackCtx, cancelFallback := context.WithTimeout(ctx, dialer.DefaultTCPTimeout)
+	fallbackRaw, tcpErr := probe.DialFallback(fallbackCtx)
+	if tcpErr == nil {
+		tcpErr = s.pingProbeContext(fallbackCtx, fallbackRaw)
+	}
+	cancelFallback()
+	if tcpErr == nil {
+		probe.ConfirmFallback(tfoErr)
+		return nil
+	}
+	if ctxErr := ctx.Err(); ctxErr != nil {
+		probe.Abandon(ctxErr)
+		return ctxErr
+	}
+
+	probe.ConfirmFailure(tfoErr, tcpErr)
+	return errors.Join(
+		fmt.Errorf("Snell TFO Ping/Pong: %w", tfoErr),
+		fmt.Errorf("Snell ordinary TCP Ping/Pong: %w", tcpErr))
+}
+
+func (s *Snell) newStreamContext(ctx context.Context, address string) (*snell.Snell, error) {
+	for {
+		raw, err := s.dialer.DialContext(ctx, "tcp", address)
+		if err != nil {
+			return nil, err
+		}
+		if probe := dialer.AdaptiveTFOProbeForConn(raw); probe != nil {
+			if err = s.finishAdaptiveTFOProbe(ctx, raw, probe); err != nil {
+				return nil, err
+			}
+			continue
+		}
+
+		stream, err := s.streamConnContext(ctx, raw)
+		if err != nil {
+			_ = raw.Close()
+			return nil, err
+		}
+		return stream, nil
+	}
+}
+
+func (s *Snell) newPooledStreamContext(ctx context.Context, address string) (*snell.Snell, error) {
+	return s.newStreamContext(ctx, address)
+}
