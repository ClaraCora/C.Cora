+package outbound
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/transport/snell"
+)
+
+type adaptiveProbeTestConn struct {
+	mu       sync.Mutex
+	response []byte
+	readErr  error
+	closed   bool
+}
+
+type adaptiveProbeTrackedConn struct {
+	net.Conn
+	mu     sync.Mutex
+	closed bool
+}
+
+func (c *adaptiveProbeTrackedConn) Close() error {
+	c.mu.Lock()
+	c.closed = true
+	c.mu.Unlock()
+	return c.Conn.Close()
+}
+
+func (c *adaptiveProbeTrackedConn) isClosed() bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.closed
+}
+
+func (c *adaptiveProbeTestConn) Read(buffer []byte) (int, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed {
+		return 0, net.ErrClosed
+	}
+	if len(c.response) != 0 {
+		n := copy(buffer, c.response)
+		c.response = c.response[n:]
+		return n, nil
+	}
+	if c.readErr != nil {
+		return 0, c.readErr
+	}
+	return 0, io.EOF
+}
+
+func (c *adaptiveProbeTestConn) Write(buffer []byte) (int, error) { return len(buffer), nil }
+func (c *adaptiveProbeTestConn) LocalAddr() net.Addr              { return &net.TCPAddr{} }
+func (c *adaptiveProbeTestConn) RemoteAddr() net.Addr             { return &net.TCPAddr{} }
+func (c *adaptiveProbeTestConn) SetDeadline(time.Time) error      { return nil }
+func (c *adaptiveProbeTestConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *adaptiveProbeTestConn) SetWriteDeadline(time.Time) error { return nil }
+func (c *adaptiveProbeTestConn) Close() error {
+	c.mu.Lock()
+	c.closed = true
+	c.mu.Unlock()
+	return nil
+}
+
+func (c *adaptiveProbeTestConn) isClosed() bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.closed
+}
+
+type adaptiveProbeStub struct {
+	confirmationTimeout time.Duration
+	fallback            net.Conn
+	fallbackErr         error
+	tfoConfirmed        bool
+	fallbackConfirmed   bool
+	failureConfirmed    bool
+	abandoned           bool
+	abandonReason       error
+}
+
+func (p *adaptiveProbeStub) ConfirmationContext(ctx context.Context) (context.Context, context.CancelFunc) {
+	return context.WithTimeout(ctx, p.confirmationTimeout)
+}
+
+func (p *adaptiveProbeStub) DialFallback(context.Context) (net.Conn, error) {
+	return p.fallback, p.fallbackErr
+}
+
+func (p *adaptiveProbeStub) ConfirmTFO()                 { p.tfoConfirmed = true }
+func (p *adaptiveProbeStub) ConfirmFallback(error)       { p.fallbackConfirmed = true }
+func (p *adaptiveProbeStub) ConfirmFailure(error, error) { p.failureConfirmed = true }
+func (p *adaptiveProbeStub) Abandon(reason error) {
+	p.abandoned = true
+	p.abandonReason = reason
+}
+
+func newAdaptiveProbeTestSnell() *Snell {
+	return &Snell{
+		psk:        []byte("test psk"),
+		obfsOption: &simpleObfsOption{},
+		version:    snell.Version4,
+	}
+}
+
+func newAdaptiveProbeSnellServer(t *testing.T, psk []byte, version int, reply bool) *adaptiveProbeTrackedConn {
+	t.Helper()
+	client, server := net.Pipe()
+	go func() {
+		defer server.Close()
+		stream := snell.ServerStreamConn(server, psk, version)
+		request := make([]byte, 1024)
+		if _, err := stream.Read(request); err != nil {
+			return
+		}
+		if reply {
+			_, _ = stream.Write([]byte{snell.CommandTunnel})
+		}
+	}()
+	return &adaptiveProbeTrackedConn{Conn: client}
+}
+
+func TestFinishAdaptiveTFOProbeKeepsConfirmedConnection(t *testing.T) {
+	s := newAdaptiveProbeTestSnell()
+	physical := &adaptiveProbeTestConn{response: []byte{snell.CommandTunnel}}
+	current := &snell.Snell{Conn: physical}
+	probe := &adaptiveProbeStub{confirmationTimeout: time.Second}
+
+	got, err := s.finishAdaptiveTFOProbe(context.Background(), &C.Metadata{}, current, current, probe, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != current || !probe.tfoConfirmed || probe.fallbackConfirmed || physical.isClosed() {
+		t.Fatalf("got=%p current=%p TFO=%v fallback=%v closed=%v", got, current, probe.tfoConfirmed, probe.fallbackConfirmed, physical.isClosed())
+	}
+}
+
+func TestFinishAdaptiveTFOProbeDoesNotFallbackOnServerError(t *testing.T) {
+	s := newAdaptiveProbeTestSnell()
+	physical := &adaptiveProbeTestConn{response: []byte{snell.CommandError, 7, 3, 'b', 'a', 'd'}}
+	current := &snell.Snell{Conn: physical}
+	probe := &adaptiveProbeStub{confirmationTimeout: time.Second}
+
+	got, err := s.finishAdaptiveTFOProbe(context.Background(), &C.Metadata{}, current, current, probe, nil)
+	if err == nil || !strings.Contains(err.Error(), "code: 7") {
+		t.Fatalf("error=%v, want the server error", err)
+	}
+	if got != current || !probe.tfoConfirmed || probe.fallbackConfirmed || probe.failureConfirmed {
+		t.Fatalf("got current=%v, TFO=%v fallback=%v failure=%v", got == current, probe.tfoConfirmed, probe.fallbackConfirmed, probe.failureConfirmed)
+	}
+	if !physical.isClosed() {
+		t.Fatal("failed request connection was not closed")
+	}
+}
+
+func TestFinishAdaptiveTFOProbeRebuildsOrdinaryTCP(t *testing.T) {
+	s := newAdaptiveProbeTestSnell()
+	failedPhysical := &adaptiveProbeTestConn{readErr: errors.New("TFO reply missing")}
+	current := &snell.Snell{Conn: failedPhysical}
+	ordinaryPhysical := newAdaptiveProbeSnellServer(t, s.psk, s.version, true)
+	probe := &adaptiveProbeStub{
+		confirmationTimeout: time.Second,
+		fallback:            ordinaryPhysical,
+	}
+	metadata := &C.Metadata{DstPort: 443}
+
+	got, err := s.finishAdaptiveTFOProbe(context.Background(), metadata, current, current, probe, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got == current || !probe.fallbackConfirmed || probe.tfoConfirmed || probe.failureConfirmed {
+		t.Fatalf("got current=%v, TFO=%v fallback=%v failure=%v", got == current, probe.tfoConfirmed, probe.fallbackConfirmed, probe.failureConfirmed)
+	}
+	if !failedPhysical.isClosed() {
+		t.Fatal("failed TFO connection was not closed before fallback")
+	}
+}
+
+func TestFinishAdaptiveTFOProbeDoesNotClassifyDoubleFailure(t *testing.T) {
+	s := newAdaptiveProbeTestSnell()
+	failedPhysical := &adaptiveProbeTestConn{readErr: errors.New("TFO reply missing")}
+	current := &snell.Snell{Conn: failedPhysical}
+	ordinaryPhysical := newAdaptiveProbeSnellServer(t, s.psk, s.version, false)
+	probe := &adaptiveProbeStub{
+		confirmationTimeout: time.Second,
+		fallback:            ordinaryPhysical,
+	}
+
+	_, err := s.finishAdaptiveTFOProbe(context.Background(), &C.Metadata{DstPort: 443}, current, current, probe, nil)
+	if err == nil {
+		t.Fatal("double failure returned nil error")
+	}
+	if !probe.failureConfirmed || probe.fallbackConfirmed || !ordinaryPhysical.isClosed() {
+		t.Fatalf("failure=%v fallback=%v fallback closed=%v", probe.failureConfirmed, probe.fallbackConfirmed, ordinaryPhysical.isClosed())
+	}
+}
+
+func TestFinishAdaptiveTFOProbeRespectsCallerCancellation(t *testing.T) {
+	s := newAdaptiveProbeTestSnell()
+	current := &snell.Snell{Conn: &adaptiveProbeTestConn{readErr: context.Canceled}}
+	probe := &adaptiveProbeStub{confirmationTimeout: time.Second}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	_, err := s.finishAdaptiveTFOProbe(ctx, &C.Metadata{}, current, current, probe, nil)
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("error=%v, want context.Canceled", err)
+	}
+	if !probe.abandoned || !errors.Is(probe.abandonReason, context.Canceled) {
+		t.Fatalf("abandoned=%v reason=%v, want caller cancellation", probe.abandoned, probe.abandonReason)
+	}
