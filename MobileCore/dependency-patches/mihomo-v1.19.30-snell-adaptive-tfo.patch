+
+// ConfirmFallback marks only an entrance proven to work over ordinary TCP.
+func (p *AdaptiveTFOProbe) ConfirmFallback(tfoErr error) {
+	if !p.completed.CompareAndSwap(false, true) {
+		return
+	}
+	logAdaptiveTFOTransition(adaptiveTFOStates.record(p.attempt, false, true), p.interfaceName, p.address, tfoErr)
+}
+
+// ConfirmFailure leaves an entrance unclassified when both paths fail.
+func (p *AdaptiveTFOProbe) ConfirmFailure(tfoErr, tcpErr error) {
+	if !p.completed.CompareAndSwap(false, true) {
+		return
+	}
+	adaptiveTFOStates.record(p.attempt, false, false)
+	log.Warnln("Snell 自适应 TFO：入口 %s（接口 %s）TFO 与普通 TCP 均未通过 Snell Ping/Pong，不记录入口结论；TFO=%v；TCP=%v",
+		p.address, p.interfaceName, tfoErr, tcpErr)
+}
+
+// Abandon resolves a canceled probe without claiming that ordinary TCP was
+// attempted. The previous entrance state is restored, or a new observation is
+// removed, so a later request can probe again.
+func (p *AdaptiveTFOProbe) Abandon(reason error) {
+	if !p.completed.CompareAndSwap(false, true) {
+		return
+	}
+	adaptiveTFOStates.record(p.attempt, false, false)
+	log.Infoln("Snell 自适应 TFO：入口 %s（接口 %s）探测已取消，未记录入口结论；普通 TCP 未尝试：%v",
+		p.address, p.interfaceName, reason)
+}
+
+func dialTCPWithEarlyData(ctx context.Context, netDialer net.Dialer, network, address string,
+	earlyData []byte) (net.Conn, error) {
+	conn, err := netDialer.DialContext(ctx, network, address)
+	if err != nil {
+		return nil, err
+	}
+	if len(earlyData) == 0 {
+		return conn, nil
+	}
+	if deadline, ok := ctx.Deadline(); ok {
+		if err := conn.SetWriteDeadline(deadline); err != nil {
+			_ = conn.Close()
+			return nil, err
+		}
+	}
+	written := 0
+	for written < len(earlyData) {
+		n, writeErr := conn.Write(earlyData[written:])
+		written += n
+		if writeErr != nil {
+			_ = conn.Close()
+			return nil, writeErr
+		}
+		if n == 0 {
+			_ = conn.Close()
+			return nil, io.ErrNoProgress
+		}
+	}
+	_ = conn.SetWriteDeadline(time.Time{})
+	return conn, nil
+}
+
+func logAdaptiveTFOTransition(transition adaptiveTFOTransition, interfaceName, address string, tfoErr error) {
+	switch transition {
+	case adaptiveTFOFirstSuccess:
+		log.Infoln("Snell 自适应 TFO：入口 %s（接口 %s）Snell Ping/Pong 确认成功，保留 TFO", address, interfaceName)
+	case adaptiveTFOFallback:
+		if adaptiveTFOHoldUntilNetworkChange.Load() {
+			log.Warnln("Snell 自适应 TFO：入口 %s（接口 %s）普通 TCP Ping/Pong 确认成功；本次 VPN 连接中仅该入口保持普通 TCP，离开蜂窝网络后再探测 TFO：%v",
+				address, interfaceName, tfoErr)
+		} else {
+			log.Warnln("Snell 自适应 TFO：入口 %s（接口 %s）普通 TCP Ping/Pong 确认成功；仅该入口回退普通 TCP，%s 后重试 TFO：%v",
+				address, interfaceName, adaptiveTFOCooldown, tfoErr)
+		}
+	case adaptiveTFORecovered:
+		log.Infoln("Snell 自适应 TFO：入口 %s（接口 %s）Snell Ping/Pong 确认成功，TFO 已恢复", address, interfaceName)
+	}
+}
