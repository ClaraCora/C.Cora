+func TestAdaptiveTFOAllProtectedSlotsUseUntrackedOrdinaryTCP(t *testing.T) {
+	cache := useTestAdaptiveTFOCache(t)
+	adaptiveTFOHoldUntilNetworkChange.Store(true)
