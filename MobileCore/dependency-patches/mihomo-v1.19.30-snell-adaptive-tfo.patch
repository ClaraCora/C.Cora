+package snell
+
+import (
+	"net"
+	"strings"
+	"testing"
+)
+
+func TestReadReplyConfirmedTreatsServerErrorAsReceived(t *testing.T) {
+	client, server := net.Pipe()
+	defer client.Close()
+	go func() {
+		defer server.Close()
+		_, _ = server.Write([]byte{CommandError, 7, 3, 'b', 'a', 'd'})
+	}()
+
+	stream := &Snell{Conn: client}
+	received, err := stream.ReadReplyConfirmed()
+	if !received {
+		t.Fatal("server CommandError was not reported as received")
+	}
+	if err == nil || !strings.Contains(err.Error(), "code: 7") {
+		t.Fatalf("error=%v, want the server error", err)
+	}
+}
+
+func TestReadReplyConfirmedDistinguishesNoReply(t *testing.T) {
+	client, server := net.Pipe()
+	_ = server.Close()
+	defer client.Close()
+
+	stream := &Snell{Conn: client}
+	received, err := stream.ReadReplyConfirmed()
+	if received || err == nil {
+		t.Fatalf("received=%v error=%v, want no reply with an error", received, err)
+	}
+}
