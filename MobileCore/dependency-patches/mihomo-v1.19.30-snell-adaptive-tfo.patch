+func TestAdaptiveTFONonFallbackResetPreservesOnlyVerifiedFallback(t *testing.T) {
+	cache := useTestAdaptiveTFOCache(t)
+	fallback := cache.decide("pdp_ip0", "192.0.2.11:443")
+	cache.record(fallback, false, true)
+	working := cache.decide("pdp_ip0", "192.0.2.12:443")
+	cache.record(working, true, false)
+	staleProbe := cache.decide("pdp_ip0", "192.0.2.13:443")
+
+	cache.resetNonFallback()
+	if got := cache.decide("pdp_ip1", "192.0.2.11:443").decision; got != adaptiveTFOUseTCP {
+		t.Fatalf("fallback decision after refresh=%v, want ordinary TCP", got)
+	}
+	if got := cache.decide("pdp_ip1", "192.0.2.12:443").decision; got != adaptiveTFOProbe {
+		t.Fatalf("working decision after refresh=%v, want a new probe", got)
+	}
+	if transition := cache.record(staleProbe, true, false); transition != adaptiveTFONoTransition {
+		t.Fatalf("stale probe transition=%v, want no transition", transition)
+	}
+}
