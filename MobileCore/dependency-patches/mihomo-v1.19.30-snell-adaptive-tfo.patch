+func adaptiveTFOContextForSnell(c net.Conn) *snellAdaptiveTFOContext {
+	var stream *snell.Snell
+	switch conn := c.(type) {
+	case *snell.Snell:
+		stream = conn
+	case *snell.PoolConn:
+		stream = conn.Snell
+	}
+	if stream == nil {
+		return nil
