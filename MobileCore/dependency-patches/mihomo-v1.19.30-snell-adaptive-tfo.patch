+func TestAdaptiveTFOCanHoldFallbackUntilNetworkChange(t *testing.T) {
+	cache := useTestAdaptiveTFOCache(t)
+	now := time.Unix(1_700_000_000, 0)
+	cache.now = func() time.Time { return now }
+	adaptiveTFOHoldUntilNetworkChange.Store(true)
+	attempt := cache.decide("pdp_ip0", "192.0.2.9:443")
+	cache.record(attempt, false, true)
+	now = now.Add(24 * time.Hour)
+	if got := cache.decide("pdp_ip1", "192.0.2.9:443").decision; got != adaptiveTFOUseTCP {
+		t.Fatalf("held decision=%v, want ordinary TCP", got)
+	}
+	if got := cache.decide("pdp_ip1", "192.0.2.10:443").decision; got != adaptiveTFOProbe {
+		t.Fatalf("different remote entrance decision=%v, want an independent probe", got)
+	}
+	cache.reset()
+	if got := cache.decide("pdp_ip2", "192.0.2.9:443").decision; got != adaptiveTFOProbe {
+		t.Fatalf("decision after network reset=%v, want probe", got)
+	}
+}
