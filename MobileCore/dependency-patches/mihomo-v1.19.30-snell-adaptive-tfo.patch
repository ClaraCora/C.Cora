+		t.Fatalf("cache entries=%d, want %d", count, adaptiveTFOMaxEntries)
+	}
+}
+
+func TestAdaptiveTFOOnlyOneInitialProbe(t *testing.T) {
+	cache := useTestAdaptiveTFOCache(t)
+	first := cache.decide("pdp_ip0", "192.0.2.6:443")
+	second := cache.decide("pdp_ip0", "192.0.2.6:443")
+	if first.decision != adaptiveTFOProbe || second.decision != adaptiveTFOUseTCP {
+		t.Fatalf("decisions=%v, %v; want probe, ordinary TCP", first.decision, second.decision)
+	}
+}
+
+func TestAdaptiveTFOStaleSuccessCannotOverrideFallback(t *testing.T) {
+	cache := useTestAdaptiveTFOCache(t)
+	initial := cache.decide("pdp_ip0", "192.0.2.7:443")
+	cache.record(initial, true, false)
+	first := cache.decide("pdp_ip0", "192.0.2.7:443")
+	stale := cache.decide("pdp_ip0", "192.0.2.7:443")
+	if got := cache.record(first, false, true); got != adaptiveTFOFallback {
+		t.Fatalf("fallback transition=%v, want fallback", got)
+	}
+	cache.record(stale, true, false)
+	if got := cache.decide("pdp_ip0", "192.0.2.7:443").decision; got != adaptiveTFOUseTCP {
+		t.Fatalf("stale success changed decision to %v", got)
+	}
+}
+
+func TestAdaptiveTFOConfirmationAndFallbackRespectCallerContext(t *testing.T) {
+	useTestAdaptiveTFOCache(t)
+	owner := &tfoConn{}
+	owner.configureAdaptiveTFO("pdp_ip0", "192.0.2.8:443",
+		func(context.Context, []byte) (net.Conn, error) { return &testConn{}, nil },
+		func(ctx context.Context, _ []byte) (net.Conn, error) { return nil, ctx.Err() })
+	_, err := owner.dialFn(context.Background(), []byte("hello"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	probe := AdaptiveTFOProbeForConn(owner)
+	confirmCtx, cancelConfirm := probe.ConfirmationContext(context.Background())
+	deadline, ok := confirmCtx.Deadline()
+	cancelConfirm()
+	if !ok {
+		t.Fatal("confirmation context has no deadline")
+	}
+	remaining := time.Until(deadline)
+	if remaining < 800*time.Millisecond || remaining > 1200*time.Millisecond {
+		t.Fatalf("confirmation timeout=%s, want about one second", remaining)
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err = probe.DialFallback(ctx)
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("fallback error=%v, want context.Canceled", err)
+	}
+}
