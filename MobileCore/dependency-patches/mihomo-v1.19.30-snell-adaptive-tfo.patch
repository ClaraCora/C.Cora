+func useTestAdaptiveTFOCache(t *testing.T) *adaptiveTFOCache {
+	t.Helper()
+	previous := adaptiveTFOStates
+	previousHold := adaptiveTFOHoldUntilNetworkChange.Load()
+	adaptiveTFOHoldUntilNetworkChange.Store(false)
+	cache := newAdaptiveTFOCache()
+	adaptiveTFOStates = cache
+	t.Cleanup(func() {
+		adaptiveTFOStates = previous
+		adaptiveTFOHoldUntilNetworkChange.Store(previousHold)
+	})
+	return cache
+}
+
+type testConn struct {
+	mu        sync.Mutex
+	readCalls int
+	closed    bool
+}
+
+func (c *testConn) Read([]byte) (int, error) {
+	c.mu.Lock()
+	c.readCalls++
+	c.mu.Unlock()
+	return 0, io.EOF
+}
+
+func (c *testConn) Write(buffer []byte) (int, error) { return len(buffer), nil }
+func (c *testConn) LocalAddr() net.Addr              { return &net.TCPAddr{} }
+func (c *testConn) RemoteAddr() net.Addr             { return &net.TCPAddr{} }
+func (c *testConn) SetDeadline(time.Time) error      { return nil }
+func (c *testConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *testConn) SetWriteDeadline(time.Time) error { return nil }
+func (c *testConn) Close() error {
+	c.mu.Lock()
+	c.closed = true
+	c.mu.Unlock()
+	return nil
+}
