+func TestAdaptiveTFOAbandonAllowsFreshProbe(t *testing.T) {
+	cache := useTestAdaptiveTFOCache(t)
+	owner := &tfoConn{}
+	owner.configureAdaptiveTFO("pdp_ip0", "192.0.2.14:443",
+		func(context.Context, []byte) (net.Conn, error) { return &testConn{}, nil },
+		func(context.Context, []byte) (net.Conn, error) { return &testConn{}, nil })
+	_, err := owner.dialFn(context.Background(), []byte("hello"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	probe := AdaptiveTFOProbeForConn(owner)
+	if probe == nil {
+		t.Fatal("missing probe")
+	}
+	probe.Abandon(context.Canceled)
+	if AdaptiveTFOProbeForConn(owner) != nil {
+		t.Fatal("abandoned probe remained active")
+	}
+	if got := cache.decide("pdp_ip0", "192.0.2.14:443").decision; got != adaptiveTFOProbe {
+		t.Fatalf("decision after abandon=%v, want a fresh probe", got)
+	}
+}
