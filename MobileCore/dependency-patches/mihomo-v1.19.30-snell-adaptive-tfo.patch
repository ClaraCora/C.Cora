+	if got := cache.decide("pdp_ip0", "192.0.2.5:443").decision; got != adaptiveTFOProbe {
+		t.Fatalf("decision after both failures = %v, want a fresh probe", got)
+	}
+}
+
+func TestAdaptiveTFOCacheIsBounded(t *testing.T) {
+	cache := useTestAdaptiveTFOCache(t)
+	for index := 0; index < adaptiveTFOMaxEntries+20; index++ {
+		cache.decide("pdp_ip0", fmt.Sprintf("192.0.2.%d:443", index))
+	}
+	cache.mu.Lock()
+	count := len(cache.entries)
+	cache.mu.Unlock()
+	if count != adaptiveTFOMaxEntries {
+		t.Fatalf("cache entries = %d, want %d", count, adaptiveTFOMaxEntries)
+	}
+}
+
+func TestAdaptiveTFOOnlyOneInitialProbe(t *testing.T) {
+	cache := useTestAdaptiveTFOCache(t)
+	first := cache.decide("pdp_ip0", "192.0.2.6:443")
+	second := cache.decide("pdp_ip0", "192.0.2.6:443")
+	if first.decision != adaptiveTFOProbe || second.decision != adaptiveTFOUseTCP {
+		t.Fatalf("decisions = %v, %v; want probe, ordinary TCP", first.decision, second.decision)
+	}
+}
+
+func TestAdaptiveTFOStaleSuccessCannotOverrideFallback(t *testing.T) {
+	cache := useTestAdaptiveTFOCache(t)
+	initial := cache.decide("pdp_ip0", "192.0.2.8:443")
+	cache.record(initial, true, false)
+	first := cache.decide("pdp_ip0", "192.0.2.8:443")
+	stale := cache.decide("pdp_ip0", "192.0.2.8:443")
+	if got := cache.record(first, false, true); got != adaptiveTFOFallback {
+		t.Fatalf("fallback transition = %v, want adaptiveTFOFallback", got)
+	}
+	cache.record(stale, true, false)
+	if got := cache.decide("pdp_ip0", "192.0.2.8:443").decision; got != adaptiveTFOUseTCP {
+		t.Fatalf("stale success changed decision to %v, want ordinary TCP", got)
+	}
+}
+
+func TestAdaptiveTFORespectsCallerCancellation(t *testing.T) {
+	useTestAdaptiveTFOCache(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err := dialAdaptiveTFO(ctx, "pdp_ip0", "192.0.2.7:443", nil,
+		func(ctx context.Context, _ []byte) (net.Conn, error) {
+			<-ctx.Done()
+			return nil, ctx.Err()
+		},
+		func(ctx context.Context, _ []byte) (net.Conn, error) {
+			return nil, ctx.Err()
+		})
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("error = %v, want context.Canceled", err)
+	}
+}
