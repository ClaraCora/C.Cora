+package snell
+
+import (
+	"bytes"
+	"io"
+	"net"
+	"testing"
+)
+
+func TestPingRoundTripAcrossSupportedTransports(t *testing.T) {
+	for _, version := range []int{Version1, Version2, Version3, Version4} {
+		t.Run(string(rune('0'+version)), func(t *testing.T) {
+			psk := []byte("ping test psk")
+			client, server := net.Pipe()
+			request := make(chan []byte, 1)
+			go func() {
+				defer server.Close()
+				stream := ServerStreamConn(server, psk, version)
+				payload := make([]byte, 2)
+				if _, err := io.ReadFull(stream, payload); err != nil {
+					request <- nil
+					return
+				}
+				request <- payload
+				_, _ = stream.Write([]byte{CommandPong})
+			}()
+
+			stream := StreamConn(client, psk, version)
+			if err := stream.Ping(); err != nil {
+				t.Fatal(err)
+			}
+			_ = stream.Close()
+			if got := <-request; !bytes.Equal(got, []byte{Version, CommandPing}) {
+				t.Fatalf("ping request=%x", got)
+			}
+		})
+	}
+}
+
+func TestPingRejectsUnexpectedResponse(t *testing.T) {
+	psk := []byte("ping test psk")
+	client, server := net.Pipe()
+	go func() {
+		defer server.Close()
+		stream := ServerStreamConn(server, psk, Version4)
+		payload := make([]byte, 2)
+		if _, err := io.ReadFull(stream, payload); err == nil {
+			_, _ = stream.Write([]byte{CommandError})
+		}
+	}()
+
+	stream := StreamConn(client, psk, Version4)
+	if err := stream.Ping(); err == nil {
+		t.Fatal("unexpected response was accepted as pong")
+	}
+	_ = stream.Close()
+}
