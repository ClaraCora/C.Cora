 )
 
 var DisableTFO = false
 
+const (
+	adaptiveTFOProbeTimeout = 500 * time.Millisecond
+	adaptiveTFOCooldown     = 10 * time.Minute
+	adaptiveTFOMaxEntries   = 128
+)
+
+type adaptiveTFOState uint8
+
+const (
+	adaptiveTFOUnknown adaptiveTFOState = iota
+	adaptiveTFOProbing
+	adaptiveTFOWorking
+	adaptiveTFOIncompatible
+)
+
+type adaptiveTFODecision uint8
+
+const (
+	adaptiveTFOUseTCP adaptiveTFODecision = iota
+	adaptiveTFOProbe
+	adaptiveTFOUseTFO
+)
+
+type adaptiveTFOTransition uint8
+
+const (
+	adaptiveTFONoTransition adaptiveTFOTransition = iota
+	adaptiveTFOFirstSuccess
+	adaptiveTFOFallback
+	adaptiveTFORecovered
+)
+
+type adaptiveTFOEntry struct {
+	state      adaptiveTFOState
+	previous   adaptiveTFOState
+	retryAt    time.Time
+	lastAccess uint64
+	revision   uint64
+}
+
+type adaptiveTFOAttempt struct {
+	key        string
+	generation uint64
+	decision   adaptiveTFODecision
+	previous   adaptiveTFOState
+	revision   uint64
+}
+
+type adaptiveTFOCache struct {
+	mu         sync.Mutex
+	entries    map[string]*adaptiveTFOEntry
+	generation uint64
+	access     uint64
+	revision   uint64
+	now        func() time.Time
+	cooldown   time.Duration
+	maxEntries int
+}
+
+func newAdaptiveTFOCache() *adaptiveTFOCache {
+	return &adaptiveTFOCache{
+		entries:    make(map[string]*adaptiveTFOEntry),
+		now:        time.Now,
+		cooldown:   adaptiveTFOCooldown,
+		maxEntries: adaptiveTFOMaxEntries,
+	}
+}
+
+func (c *adaptiveTFOCache) decide(interfaceName, address string) adaptiveTFOAttempt {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	c.access++
+	key := strings.ToLower(strings.TrimSpace(interfaceName)) + "\x00" + address
+	entry, exists := c.entries[key]
+	if !exists {
+		c.evictOldestLocked()
+		entry = &adaptiveTFOEntry{
+			state:      adaptiveTFOProbing,
+			previous:   adaptiveTFOUnknown,
+			lastAccess: c.access,
+			revision:   c.nextRevisionLocked(),
+		}
+		c.entries[key] = entry
+		return adaptiveTFOAttempt{key: key, generation: c.generation, decision: adaptiveTFOProbe,
+			revision: entry.revision}
+	}
+
+	entry.lastAccess = c.access
+	switch entry.state {
+	case adaptiveTFOProbing:
+		return adaptiveTFOAttempt{key: key, generation: c.generation, decision: adaptiveTFOUseTCP,
+			revision: entry.revision}
+	case adaptiveTFOWorking:
+		return adaptiveTFOAttempt{key: key, generation: c.generation, decision: adaptiveTFOUseTFO,
+			previous: adaptiveTFOWorking, revision: entry.revision}
+	case adaptiveTFOIncompatible:
+		if c.now().Before(entry.retryAt) {
+			return adaptiveTFOAttempt{key: key, generation: c.generation, decision: adaptiveTFOUseTCP,
+				previous: adaptiveTFOIncompatible, revision: entry.revision}
+		}
+		entry.state = adaptiveTFOProbing
+		entry.previous = adaptiveTFOIncompatible
+		entry.revision = c.nextRevisionLocked()
+		return adaptiveTFOAttempt{key: key, generation: c.generation, decision: adaptiveTFOProbe,
+			previous: adaptiveTFOIncompatible, revision: entry.revision}
+	default:
+		delete(c.entries, key)
+		return c.decideLocked(interfaceName, address)
+	}
+}
+
+func (c *adaptiveTFOCache) decideLocked(interfaceName, address string) adaptiveTFOAttempt {
+	c.evictOldestLocked()
+	c.access++
+	key := strings.ToLower(strings.TrimSpace(interfaceName)) + "\x00" + address
+	c.entries[key] = &adaptiveTFOEntry{
+		state:      adaptiveTFOProbing,
+		previous:   adaptiveTFOUnknown,
+		lastAccess: c.access,
+		revision:   c.nextRevisionLocked(),
+	}
+	return adaptiveTFOAttempt{key: key, generation: c.generation, decision: adaptiveTFOProbe,
+		revision: c.entries[key].revision}
+}
+
+func (c *adaptiveTFOCache) record(attempt adaptiveTFOAttempt, tfoSucceeded, fallbackSucceeded bool) adaptiveTFOTransition {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if attempt.generation != c.generation {
+		return adaptiveTFONoTransition
+	}
+	entry, exists := c.entries[attempt.key]
+	if !exists || entry.revision != attempt.revision {
+		return adaptiveTFONoTransition
+	}
+	c.access++
+	entry.lastAccess = c.access
+	if tfoSucceeded {
+		if attempt.decision == adaptiveTFOUseTFO {
+			return adaptiveTFONoTransition
+		}
+		previous := attempt.previous
+		if entry.state == adaptiveTFOProbing {
+			previous = entry.previous
+		}
+		entry.state = adaptiveTFOWorking
+		entry.previous = adaptiveTFOWorking
+		entry.retryAt = time.Time{}
+		entry.revision = c.nextRevisionLocked()
+		if previous == adaptiveTFOIncompatible {
+			return adaptiveTFORecovered
+		}
+		if previous == adaptiveTFOUnknown {
+			return adaptiveTFOFirstSuccess
+		}
+		return adaptiveTFONoTransition
+	}
+	if fallbackSucceeded {
+		wasIncompatible := entry.state == adaptiveTFOIncompatible || entry.previous == adaptiveTFOIncompatible
+		entry.state = adaptiveTFOIncompatible
+		entry.previous = adaptiveTFOIncompatible
+		entry.retryAt = c.now().Add(c.cooldown)
+		entry.revision = c.nextRevisionLocked()
+		if !wasIncompatible || attempt.decision == adaptiveTFOProbe {
+			return adaptiveTFOFallback
+		}
+		return adaptiveTFONoTransition
+	}
+
+	// A path where both TFO and ordinary TCP fail has not proven TFO to be the
+	// cause. Restore the prior state instead of poisoning this entrance.
+	if entry.state == adaptiveTFOProbing {
+		if entry.previous == adaptiveTFOIncompatible {
+			entry.state = adaptiveTFOIncompatible
+			entry.retryAt = c.now().Add(c.cooldown)
+			entry.revision = c.nextRevisionLocked()
+		} else {
+			delete(c.entries, attempt.key)
+		}
+	}
+	return adaptiveTFONoTransition
+}
+
+func (c *adaptiveTFOCache) nextRevisionLocked() uint64 {
+	c.revision++
+	return c.revision
+}
+
+func (c *adaptiveTFOCache) reset() {
+	c.mu.Lock()
+	c.generation++
+	for key := range c.entries {
+		delete(c.entries, key)
+	}
+	c.mu.Unlock()
+}
+
+func (c *adaptiveTFOCache) evictOldestLocked() {
+	if len(c.entries) < c.maxEntries {
+		return
+	}
+	var oldestKey string
+	var oldestAccess uint64
+	first := true
+	for key, entry := range c.entries {
+		if first || entry.lastAccess < oldestAccess {
+			oldestKey = key
+			oldestAccess = entry.lastAccess
+			first = false
+		}
+	}
+	delete(c.entries, oldestKey)
+}
+
+var (
+	adaptiveTFOEnabled atomic.Bool
+	adaptiveTFOStates  = newAdaptiveTFOCache()
+)
+
+// SetAdaptiveTFOEnabled enables per-entrance Snell fallback. Callers must also
+// opt a dialer in with WithAdaptiveTFO; other protocols are never affected.
+func SetAdaptiveTFOEnabled(enabled bool) {
+	if adaptiveTFOEnabled.Swap(enabled) != enabled {
+		adaptiveTFOStates.reset()
+	}
+}
+
+func AdaptiveTFOEnabled() bool {
+	return adaptiveTFOEnabled.Load()
+}
+
+// ResetAdaptiveTFO clears path-specific observations after a network change.
+// It does not retain sockets, payloads, or DNS results.
+func ResetAdaptiveTFO() {
+	adaptiveTFOStates.reset()
+}
