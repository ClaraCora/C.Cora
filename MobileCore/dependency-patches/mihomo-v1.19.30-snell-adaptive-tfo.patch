+
+func (c *adaptiveTFOCache) reserveSlotLocked() bool {
+	if len(c.entries) < c.maxEntries {
+		return true
+	}
+	now := c.now()
+	holdFallback := adaptiveTFOHoldUntilNetworkChange.Load()
+	var oldestKey string
+	var oldestAccess uint64
+	first := true
+	for key, entry := range c.entries {
+		if entry.state == adaptiveTFOProbing {
+			continue
+		}
+		if entry.state == adaptiveTFOIncompatible &&
+			(holdFallback || now.Before(entry.retryAt)) {
+			continue
+		}
+		if first || entry.lastAccess < oldestAccess {
+			oldestKey = key
+			oldestAccess = entry.lastAccess
+			first = false
+		}
+	}
+	if first {
+		return false
+	}
+	delete(c.entries, oldestKey)
+	return true
