+func TestAdaptiveTFOBothFailuresDoNotPoisonEntrance(t *testing.T) {
+	cache := useTestAdaptiveTFOCache(t)
+	owner := &tfoConn{}
+	owner.configureAdaptiveTFO("pdp_ip0", "192.0.2.3:443",
+		func(context.Context, []byte) (net.Conn, error) { return nil, errors.New("TFO failed") },
+		func(context.Context, []byte) (net.Conn, error) { return nil, errors.New("TCP failed") })
+	_, err := owner.dialFn(context.Background(), []byte("hello"))
+	if err == nil {
+		t.Fatal("TFO dial unexpectedly succeeded")
+	}
+	probe := AdaptiveTFOProbeForConn(owner)
+	if probe == nil {
+		t.Fatal("TFO dial error lost the protocol probe")
+	}
+	_, tcpErr := probe.DialFallback(context.Background())
+	probe.ConfirmFailure(err, tcpErr)
+	if got := cache.decide("pdp_ip0", "192.0.2.3:443").decision; got != adaptiveTFOProbe {
+		t.Fatalf("decision after both failures=%v, want a fresh probe", got)
+	}
+}
