+package snell
+
+// ReadReplyConfirmed reports whether the server reply command was received,
+// independently from whether that command represents a successful tunnel.
+// A CommandError still proves that the request reached the Snell server.
+func (s *Snell) ReadReplyConfirmed() (received bool, err error) {
+	err = s.ReadReply()
+	return s.reply, err
+}
