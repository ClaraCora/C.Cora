+func (c *tfoConn) dialAdaptiveTFO(ctx context.Context, interfaceName, address string, earlyData []byte,
+	tfoDial, tcpDial earlyDialFunc) (net.Conn, error) {
+	if len(earlyData) == 0 {
+		return tfoDial(ctx, earlyData)
+	}
+	attempt := adaptiveTFOStates.decide(interfaceName, address)
+	switch attempt.decision {
+	case adaptiveTFOUseTCP:
+		return tcpDial(ctx, earlyData)
+	case adaptiveTFOProbe:
+		probe := &AdaptiveTFOProbe{
+			attempt:       attempt,
+			interfaceName: interfaceName,
+			address:       address,
+			tcpDial:       tcpDial,
+		}
+		c.adaptiveProbe.Store(probe)
+		log.Infoln("Snell 自适应 TFO：开始探测入口 %s（接口 %s）的 Snell 握手", address, interfaceName)
+	}
+	return tfoDial(ctx, earlyData)
+}
