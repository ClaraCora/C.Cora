+func (s *Snell) confirmAdaptiveTFOFallback(ctx context.Context, current *snell.Snell,
+	owner net.Conn, probe snellAdaptiveTFOProbe, tfoErr, tcpErr error) (*snell.Snell, error) {
+	var replyReceived bool
+	if tcpErr == nil {
+		replyReceived, tcpErr = readSnellReplyContext(ctx, current)
+	}
+	if replyReceived {
+		probe.ConfirmFallback(tfoErr)
+		if tcpErr != nil && owner != nil {
+			_ = owner.Close()
+		}
+		return current, tcpErr
+	}
+	if owner != nil {
+		_ = owner.Close()
+	}
+	probe.ConfirmFailure(tfoErr, tcpErr)
+	return nil, errors.Join(
+		fmt.Errorf("Snell TFO handshake: %w", tfoErr),
+		fmt.Errorf("Snell ordinary TCP handshake: %w", tcpErr))
+}
+
+func (s *Snell) finishAdaptiveTFOProbe(ctx context.Context, metadata *C.Metadata, current *snell.Snell,
+	owner net.Conn, probe snellAdaptiveTFOProbe, tfoErr error) (*snell.Snell, error) {
+	if tfoErr == nil {
+		probeCtx, cancel := probe.ConfirmationContext(ctx)
+		var replyReceived bool
+		replyReceived, tfoErr = readSnellReplyContext(probeCtx, current)
+		cancel()
+		if replyReceived {
+			probe.ConfirmTFO()
+			if tfoErr != nil && owner != nil {
+				_ = owner.Close()
+			}
+			return current, tfoErr
+		}
+	}
+
+	if owner != nil {
+		_ = owner.Close()
+	}
+	if ctxErr := ctx.Err(); ctxErr != nil {
+		probe.Abandon(ctxErr)
+		return nil, ctxErr
+	}
+
+	raw, tcpErr := probe.DialFallback(ctx)
+	fallbackOwner := raw
+	var fallback *snell.Snell
+	if tcpErr == nil {
+		fallback, tcpErr = s.streamConnContext(ctx, raw)
+		if tcpErr == nil {
+			fallbackOwner = fallback
+			tcpErr = s.writeHeaderContext(ctx, fallback, metadata)
+		}
+	}
+	return s.confirmAdaptiveTFOFallback(ctx, fallback, fallbackOwner, probe, tfoErr, tcpErr)
+}
+
+func (s *Snell) newPooledStreamContext(ctx context.Context, address string) (*snell.Snell, error) {
+	raw, err := s.dialer.DialContext(ctx, "tcp", address)
+	if err != nil {
+		return nil, err
+	}
+	stream, streamErr := s.streamConnContext(ctx, raw)
+	if streamErr == nil {
+		return stream, nil
+	}
+	probe := dialer.AdaptiveTFOProbeForConn(raw)
+	_ = raw.Close()
+	if probe == nil {
+		return nil, streamErr
+	}
+	if ctxErr := ctx.Err(); ctxErr != nil {
+		probe.Abandon(ctxErr)
+		return nil, ctxErr
+	}
+
+	fallbackRaw, tcpErr := probe.DialFallback(ctx)
+	if tcpErr == nil {
+		stream, tcpErr = s.streamConnContextWithProbe(
+			ctx, fallbackRaw, probe, true, streamErr)
+		if tcpErr == nil {
+			return stream, nil
+		}
+		_ = fallbackRaw.Close()
+	}
+	probe.ConfirmFailure(streamErr, tcpErr)
+	return nil, errors.Join(
+		fmt.Errorf("Snell TFO wrapper handshake: %w", streamErr),
+		fmt.Errorf("Snell ordinary TCP wrapper handshake: %w", tcpErr))
+}
