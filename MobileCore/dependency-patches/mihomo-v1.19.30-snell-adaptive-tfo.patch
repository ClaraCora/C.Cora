+	}
+	cache.mu.Lock()
+	count := len(cache.entries)
+	_, keptFirstProbe := cache.entries[first.key]
+	cache.mu.Unlock()
+	if count != adaptiveTFOMaxEntries {
+		t.Fatalf("cache entries=%d, want %d", count, adaptiveTFOMaxEntries)
+	}
+	if !keptFirstProbe {
+		t.Fatal("in-flight probe was evicted at the cache limit")
+	}
+	if got := cache.decide("pdp_ip0", "198.51.100.1:443").decision; got != adaptiveTFOUseTCP {
+		t.Fatalf("overflow decision=%v, want temporary ordinary TCP", got)
+	}
+	cache.record(first, true, false)
+	if got := cache.decide("pdp_ip0", "198.51.100.1:443").decision; got != adaptiveTFOProbe {
+		t.Fatalf("decision after a slot became evictable=%v, want probe", got)
+	}
