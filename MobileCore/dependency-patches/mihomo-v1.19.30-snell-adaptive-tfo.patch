@@ -0,0 +1,25 @@
+package snell
+
+import (
+	"fmt"
+	"io"
+)
+
+// Ping verifies the Snell transport without opening a destination tunnel.
+// A ping connection is single-use because servers close it after the pong.
+func (s *Snell) Ping() error {
+	request := []byte{Version, CommandPing}
+	if n, err := s.Conn.Write(request); err != nil {
+		return err
+	} else if n != len(request) {
+		return io.ErrShortWrite
+	}
+	var response [1]byte
+	if _, err := io.ReadFull(s.Conn, response[:]); err != nil {
+		return err
+	}
+	if response[0] != CommandPong {
+		return fmt.Errorf("unexpected Snell ping response: %d", response[0])
+	}
+	return nil
+}
