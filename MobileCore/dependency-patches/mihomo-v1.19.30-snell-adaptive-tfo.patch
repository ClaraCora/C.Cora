+package dialer
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"testing"
+	"time"
+)
+
+func useTestAdaptiveTFOCache(t *testing.T) *adaptiveTFOCache {
+	t.Helper()
+	previous := adaptiveTFOStates
+	cache := newAdaptiveTFOCache()
+	adaptiveTFOStates = cache
+	t.Cleanup(func() { adaptiveTFOStates = previous })
+	return cache
+}
+
+func testPipeConn(t *testing.T) net.Conn {
+	t.Helper()
+	left, right := net.Pipe()
+	t.Cleanup(func() {
+		_ = left.Close()
+		_ = right.Close()
+	})
+	return left
+}
+
+func TestAdaptiveTFOSuccessKeepsTFO(t *testing.T) {
+	useTestAdaptiveTFOCache(t)
+	tfoCalls := 0
+	tcpCalls := 0
+	tfoDial := func(context.Context, []byte) (net.Conn, error) {
+		tfoCalls++
+		return testPipeConn(t), nil
+	}
+	tcpDial := func(context.Context, []byte) (net.Conn, error) {
+		tcpCalls++
+		return testPipeConn(t), nil
+	}
+
+	for index := 0; index < 2; index++ {
+		conn, err := dialAdaptiveTFO(context.Background(), "pdp_ip0", "192.0.2.1:443", []byte("hello"), tfoDial, tcpDial)
+		if err != nil {
+			t.Fatal(err)
+		}
+		_ = conn.Close()
+	}
+	if tfoCalls != 2 || tcpCalls != 0 {
+		t.Fatalf("TFO calls = %d, TCP calls = %d; want 2, 0", tfoCalls, tcpCalls)
+	}
+}
+
+func TestAdaptiveTFOFallsBackAndCachesIncompatibleEntrance(t *testing.T) {
+	useTestAdaptiveTFOCache(t)
+	tfoCalls := 0
+	tcpCalls := 0
+	tfoDial := func(context.Context, []byte) (net.Conn, error) {
+		tfoCalls++
+		return nil, context.DeadlineExceeded
+	}
+	tcpDial := func(context.Context, []byte) (net.Conn, error) {
+		tcpCalls++
+		return testPipeConn(t), nil
+	}
+
+	for index := 0; index < 2; index++ {
+		conn, err := dialAdaptiveTFO(context.Background(), "pdp_ip0", "192.0.2.2:443", nil, tfoDial, tcpDial)
+		if err != nil {
+			t.Fatal(err)
+		}
+		_ = conn.Close()
+	}
+	if tfoCalls != 1 || tcpCalls != 2 {
+		t.Fatalf("TFO calls = %d, TCP calls = %d; want 1, 2", tfoCalls, tcpCalls)
+	}
+}
+
+func TestAdaptiveTFOCooldownRetriesAndRecovers(t *testing.T) {
+	cache := useTestAdaptiveTFOCache(t)
+	now := time.Unix(1_700_000_000, 0)
+	cache.now = func() time.Time { return now }
+	tfoWorks := false
+	tfoCalls := 0
+	tfoDial := func(context.Context, []byte) (net.Conn, error) {
+		tfoCalls++
+		if !tfoWorks {
+			return nil, context.DeadlineExceeded
+		}
+		return testPipeConn(t), nil
+	}
+	tcpDial := func(context.Context, []byte) (net.Conn, error) {
+		return testPipeConn(t), nil
+	}
+
+	conn, err := dialAdaptiveTFO(context.Background(), "pdp_ip0", "192.0.2.3:443", nil, tfoDial, tcpDial)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = conn.Close()
+	now = now.Add(cache.cooldown - time.Second)
+	conn, err = dialAdaptiveTFO(context.Background(), "pdp_ip0", "192.0.2.3:443", nil, tfoDial, tcpDial)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = conn.Close()
+	if tfoCalls != 1 {
+		t.Fatalf("TFO retried before cooldown: calls = %d", tfoCalls)
+	}
+
+	tfoWorks = true
+	now = now.Add(2 * time.Second)
+	conn, err = dialAdaptiveTFO(context.Background(), "pdp_ip0", "192.0.2.3:443", nil, tfoDial, tcpDial)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = conn.Close()
+	if tfoCalls != 2 {
+		t.Fatalf("TFO calls after cooldown = %d, want 2", tfoCalls)
+	}
+}
+
+func TestAdaptiveTFONetworkResetForgetsEntrance(t *testing.T) {
+	cache := useTestAdaptiveTFOCache(t)
+	attempt := cache.decide("pdp_ip0", "192.0.2.4:443")
+	cache.record(attempt, false, true)
+	if got := cache.decide("pdp_ip0", "192.0.2.4:443").decision; got != adaptiveTFOUseTCP {
+		t.Fatalf("cached decision = %v, want ordinary TCP", got)
+	}
+	cache.reset()
+	if got := cache.decide("pdp_ip0", "192.0.2.4:443").decision; got != adaptiveTFOProbe {
+		t.Fatalf("decision after reset = %v, want TFO probe", got)
+	}
+}
+
+func TestAdaptiveTFOBothFailuresDoNotPoisonEntrance(t *testing.T) {
+	cache := useTestAdaptiveTFOCache(t)
+	failure := errors.New("unreachable")
+	_, err := dialAdaptiveTFO(context.Background(), "pdp_ip0", "192.0.2.5:443", nil,
