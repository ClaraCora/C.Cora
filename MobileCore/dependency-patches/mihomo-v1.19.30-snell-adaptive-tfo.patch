+func TestAdaptiveTFOFallbackIsFreshAndCachesOnlyAfterConfirmation(t *testing.T) {
+	useTestAdaptiveTFOCache(t)
+	tfoCalls := 0
+	tcpCalls := 0
+	var fallbackEarlyData []byte
+	owner := &tfoConn{}
+	_, err := owner.dialAdaptiveTFO(context.Background(), "pdp_ip0", "192.0.2.2:443", []byte("encrypted TFO payload"),
+		func(context.Context, []byte) (net.Conn, error) {
+			tfoCalls++
+			return &testConn{}, nil
+		},
+		func(_ context.Context, earlyData []byte) (net.Conn, error) {
+			tcpCalls++
+			fallbackEarlyData = append([]byte(nil), earlyData...)
+			return &testConn{}, nil
+		})
+	if err != nil {
+		t.Fatal(err)
+	}
+	probe := AdaptiveTFOProbeForConn(owner)
+	if probe == nil {
+		t.Fatal("missing probe")
+	}
+	if _, err = probe.DialFallback(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if len(fallbackEarlyData) != 0 {
+		t.Fatalf("fallback replayed %d raw bytes instead of rebuilding the protocol", len(fallbackEarlyData))
+	}
+	if got := adaptiveTFOStates.decide("pdp_ip0", "192.0.2.2:443").decision; got != adaptiveTFOUseTCP {
+		t.Fatalf("concurrent decision before confirmation=%v, want ordinary TCP while probing", got)
+	}
+	probe.ConfirmFallback(context.DeadlineExceeded)
+
+	second := &tfoConn{}
+	_, err = second.dialAdaptiveTFO(context.Background(), "pdp_ip0", "192.0.2.2:443", []byte("next write"),
+		func(context.Context, []byte) (net.Conn, error) {
+			tfoCalls++
+			return &testConn{}, nil
+		},
+		func(context.Context, []byte) (net.Conn, error) {
+			tcpCalls++
+			return &testConn{}, nil
+		})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if tfoCalls != 1 || tcpCalls != 2 || AdaptiveTFOProbeForConn(second) != nil {
+		t.Fatalf("cached fallback: TFO calls=%d, TCP calls=%d, probe=%v", tfoCalls, tcpCalls, AdaptiveTFOProbeForConn(second))
+	}
+}
