+func TestAdaptiveTFOCooldownRetriesAndRecovers(t *testing.T) {
+	cache := useTestAdaptiveTFOCache(t)
+	now := time.Unix(1_700_000_000, 0)
+	cache.now = func() time.Time { return now }
+	first := cache.decide("pdp_ip0", "192.0.2.4:443")
+	cache.record(first, false, true)
+	if got := cache.decide("pdp_ip0", "192.0.2.4:443").decision; got != adaptiveTFOUseTCP {
+		t.Fatalf("decision during cooldown=%v, want ordinary TCP", got)
+	}
+	now = now.Add(cache.cooldown + time.Second)
+	retry := cache.decide("pdp_ip0", "192.0.2.4:443")
+	if retry.decision != adaptiveTFOProbe {
+		t.Fatalf("decision after cooldown=%v, want probe", retry.decision)
+	}
+	if transition := cache.record(retry, true, false); transition != adaptiveTFORecovered {
+		t.Fatalf("recovery transition=%v, want recovered", transition)
+	}
+}
