diff --git a/common/pool/oversize_pool_test.go b/common/pool/oversize_pool_test.go
new file mode 100644
index 0000000..34d6e61
--- /dev/null
+++ b/common/pool/oversize_pool_test.go
@@ -0,0 +1,72 @@
+package pool
+
+import (
+	"runtime"
+	"testing"
+)
+
+func TestOversizePoolBoundary(t *testing.T) {
+	tests := []struct {
+		size    int
+		wantCap int
+	}{
+		{size: 65535, wantCap: 65536},
+		{size: 65536, wantCap: 65536},
+		{size: 65537, wantCap: maxPooledSize},
+		{size: 65551, wantCap: maxPooledSize},
+		{size: 65552, wantCap: maxPooledSize},
+		{size: 65553, wantCap: 65553},
+	}
+
+	for _, test := range tests {
+		data := DefaultAllocator.Get(test.size)
+		if got := len(data); got != test.size {
+			t.Errorf("Get(%d) len = %d, want %d", test.size, got, test.size)
+		}
+		if got := cap(data); got != test.wantCap {
+			t.Errorf("Get(%d) cap = %d, want %d", test.size, got, test.wantCap)
+		}
+		if err := DefaultAllocator.Put(data); err != nil {
+			t.Errorf("Put(Get(%d)) failed: %v", test.size, err)
+		}
+	}
+}
+
+func TestOversizePoolRetentionIsBounded(t *testing.T) {
+	allocator := NewAllocator().(*defaultAllocator)
+	for index := 0; index <= maxOversizeBuffers; index++ {
+		if err := allocator.Put(make([]byte, maxPooledSize)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if got := len(allocator.oversize); got != maxOversizeBuffers {
+		t.Fatalf("retained buffers = %d, want %d", got, maxOversizeBuffers)
+	}
+	runtime.GC()
+	if got := len(allocator.oversize); got != maxOversizeBuffers {
+		t.Fatalf("retained buffers after GC = %d, want %d", got, maxOversizeBuffers)
+	}
+}
+
+func BenchmarkOversizePool65551(b *testing.B) {
+	b.ReportAllocs()
+	for i := 0; i < b.N; i++ {
+		data := DefaultAllocator.Get(65551)
+		if err := DefaultAllocator.Put(data); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
+
+func BenchmarkOversizePool65551Parallel(b *testing.B) {
+	allocator := NewAllocator()
+	b.ReportAllocs()
+	b.RunParallel(func(pb *testing.PB) {
+		for pb.Next() {
+			data := allocator.Get(65551)
+			if err := allocator.Put(data); err != nil {
+				b.Fatal(err)
+			}
+		}
+	})
+}
