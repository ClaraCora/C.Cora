@@ -48,8 +51,14 @@ func (alloc *defaultAllocator) Get(size int) []byte {
 		panic("alloc.Get: len out of range")
 	case size == 0:
 		return nil
-	case size > 65536:
+	case size > maxPooledSize:
 		return make([]byte, size)
+	case size > 1<<16:
+		if value := alloc.oversize.Get(); value != nil {
+			atomic.AddInt32(&alloc.oversizeCount, -1)
+			return value.(*[maxPooledSize]byte)[:size]
+		}
+		return make([]byte, maxPooledSize)[:size]
 	default:
 		var index uint16
 		if size > 64 {
@@ -91,8 +97,17 @@ func (alloc *defaultAllocator) Get(size int) []byte {
 }
 
 // Put returns a []byte to pool for future use,
-// which the cap must be exactly 2^n
+// which the cap must be exactly 2^n or the dedicated 65552-byte size.
 func (alloc *defaultAllocator) Put(buf []byte) error {
+	if cap(buf) == maxPooledSize {
+		buf = buf[:maxPooledSize]
+		if atomic.AddInt32(&alloc.oversizeCount, 1) <= maxOversizeBuffers {
+			alloc.oversize.Put((*[maxPooledSize]byte)(buf))
+		} else {
+			atomic.AddInt32(&alloc.oversizeCount, -1)
+		}
+		return nil
+	}
 	if cap(buf) == 0 || cap(buf) > 65536 {
 		return nil
 	}
diff --git a/common/pool/oversize_pool_test.go b/common/pool/oversize_pool_test.go
new file mode 100644
index 0000000..80cdffa
--- /dev/null
+++ b/common/pool/oversize_pool_test.go
@@ -0,0 +1,40 @@
+package pool
+
+import "testing"
+
+func TestOversizePoolBoundary(t *testing.T) {
+	tests := []struct {
+		size    int
+		wantCap int
+	}{
+		{size: 65535, wantCap: 65536},
+		{size: 65536, wantCap: 65536},
+		{size: 65537, wantCap: maxPooledSize},
+		{size: 65551, wantCap: maxPooledSize},
+		{size: 65552, wantCap: maxPooledSize},
+		{size: 65553, wantCap: 65553},
+	}
+
+	for _, test := range tests {
+		data := DefaultAllocator.Get(test.size)
+		if got := len(data); got != test.size {
+			t.Errorf("Get(%d) len = %d, want %d", test.size, got, test.size)
+		}
+		if got := cap(data); got != test.wantCap {
+			t.Errorf("Get(%d) cap = %d, want %d", test.size, got, test.wantCap)
+		}
+		if err := DefaultAllocator.Put(data); err != nil {
+			t.Errorf("Put(Get(%d)) failed: %v", test.size, err)
+		}
+	}
+}
+
+func BenchmarkOversizePool65551(b *testing.B) {
+	b.ReportAllocs()
+	for i := 0; i < b.N; i++ {
+		data := DefaultAllocator.Get(65551)
+		if err := DefaultAllocator.Put(data); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
