diff --git a/adapter/outbound/shadowsocks_memory_test.go b/adapter/outbound/shadowsocks_memory_test.go
new file mode 100644
index 0000000..b80e322
--- /dev/null
+++ b/adapter/outbound/shadowsocks_memory_test.go
@@ -0,0 +1,73 @@
+package outbound
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func TestSS2022ConnectionLimiterOnlyAppliesToSS2022(t *testing.T) {
+	if limiter := newSS2022ConnectionLimiter("aes-256-gcm"); limiter != nil {
+		t.Fatal("legacy Shadowsocks unexpectedly received a TCP limiter")
+	}
+	if limiter := newSS2022ConnectionLimiter("2022-blake3-aes-256-gcm"); cap(limiter) != ss2022MaxTCPConnections {
+		t.Fatalf("SS2022 limiter capacity = %d, want %d", cap(limiter), ss2022MaxTCPConnections)
+	}
+}
+
+func TestSS2022ConnectionLimiterHonorsContextCancellation(t *testing.T) {
+	limiter := newSS2022ConnectionLimiter("2022-blake3-aes-256-gcm")
+	for i := 0; i < ss2022MaxTCPConnections; i++ {
+		if err := limiter.acquire(context.Background()); err != nil {
+			t.Fatalf("fill limiter: %v", err)
+		}
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if err := limiter.acquire(ctx); !errors.Is(err, context.Canceled) {
+		t.Fatalf("acquire error = %v, want context.Canceled", err)
+	}
+
+	limiter.release()
+	if err := limiter.acquire(context.Background()); err != nil {
+		t.Fatalf("acquire after release: %v", err)
+	}
+	for i := 0; i < ss2022MaxTCPConnections; i++ {
+		limiter.release()
+	}
+}
+
+type ss2022CountingConn struct {
+	C.Conn
+	closeCount int
+}
+
+func (c *ss2022CountingConn) Close() error {
+	c.closeCount++
+	return nil
+}
+
+func TestSS2022LimitedConnReleasesPermitOnce(t *testing.T) {
+	limiter := newSS2022ConnectionLimiter("2022-blake3-aes-256-gcm")
+	if err := limiter.acquire(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	base := &ss2022CountingConn{}
+	conn := &ss2022LimitedConn{Conn: base, limiter: limiter}
+
+	if err := conn.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := conn.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if got := len(limiter); got != 0 {
+		t.Fatalf("held permits = %d, want 0", got)
+	}
+	if base.closeCount != 2 {
+		t.Fatalf("underlying Close calls = %d, want 2", base.closeCount)
+	}
+}
