+type ss2022ConnectionLimiter chan struct{}
+
+func newSS2022ConnectionLimiter(cipher string) ss2022ConnectionLimiter {
+	if !strings.HasPrefix(strings.ToLower(cipher), "2022-") {
+		return nil
+	}
+	return make(ss2022ConnectionLimiter, ss2022MaxTCPConnections)
+}
+
+func (l ss2022ConnectionLimiter) acquire(ctx context.Context) error {
+	if l == nil {
+		return nil
+	}
+	select {
+	case l <- struct{}{}:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+func (l ss2022ConnectionLimiter) release() {
+	if l != nil {
+		<-l
+	}
+}
+
+type ss2022LimitedConn struct {
+	C.Conn
+	limiter ss2022ConnectionLimiter
+	once    sync.Once
+}
+
+func (c *ss2022LimitedConn) Close() error {
+	defer c.once.Do(c.limiter.release)
+	return c.Conn.Close()
+}
