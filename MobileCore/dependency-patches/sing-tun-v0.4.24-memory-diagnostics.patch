--- /dev/null
+++ b/memory_diagnostics.go
@@ -0,0 +1,19 @@
+package tun
+
+type QueueStats struct {
+	RXPackets int    `json:"tunRXQueuedPackets"`
+	RXBytes   uint64 `json:"tunRXQueuedBytes"`
+	TXPackets int    `json:"tunTXQueuedPackets"`
+	TXBytes   uint64 `json:"tunTXQueuedBytes"`
+}
+
+// QueueSnapshot is optional. Unsupported stacks/targets return nil, rather
+// than reporting an unmeasured queue as empty.
+func QueueSnapshot(t Tun) *QueueStats {
+	if source, ok := t.(interface{ queueSnapshot() *QueueStats }); ok {
+		return source.queueSnapshot()
+	}
+	return nil
+}
+
+type queueStatsSource interface{ QueueStats() (int, uint64) }
diff --git a/memory_diagnostics_darwin.go b/memory_diagnostics_darwin.go
new file mode 100644
index 0000000..8b92b2a
--- /dev/null
+++ b/memory_diagnostics_darwin.go
@@ -0,0 +1,14 @@
+package tun
+
+// Sources belong to this NativeTun, and are cleared at close. No global
+// registry holds a previous endpoint alive across VPN sessions.
+func (t *NativeTun) queueSnapshot() *QueueStats {
+	t.diagnosticMu.Lock()
+	defer t.diagnosticMu.Unlock()
+	if t.diagnosticRX == nil || t.diagnosticTX == nil {
+		return nil
+	}
+	rxPackets, rxBytes := t.diagnosticRX.QueueStats()
+	txPackets, txBytes := t.diagnosticTX.QueueStats()
+	return &QueueStats{rxPackets, rxBytes, txPackets, txBytes}
+}
diff --git a/memory_diagnostics_darwin_test.go b/memory_diagnostics_darwin_test.go
new file mode 100644
index 0000000..a2f5d6e
--- /dev/null
+++ b/memory_diagnostics_darwin_test.go
@@ -0,0 +1,29 @@
+package tun
+
+import "testing"
+
+type testQueueSource struct {
+	packets int
+	bytes   uint64
+}
+
+func (q testQueueSource) QueueStats() (int, uint64) { return q.packets, q.bytes }
+
+func TestDiagnosticNativeTunLifetime(t *testing.T) {
+	native := &NativeTun{}
+	if QueueSnapshot(native) != nil {
+		t.Fatal("unconfigured queue reported as empty")
+	}
+	native.diagnosticRX, native.diagnosticTX = testQueueSource{2, 100}, testQueueSource{3, 120}
+	snapshot := QueueSnapshot(native)
+	if snapshot == nil || snapshot.RXPackets != 2 || snapshot.RXBytes != 100 || snapshot.TXPackets != 3 || snapshot.TXBytes != 120 {
+		t.Fatalf("bad snapshot: %+v", snapshot)
+	}
+	native.diagnosticMu.Lock()
+	native.diagnosticClosed = true
+	native.diagnosticRX, native.diagnosticTX = nil, nil
+	native.diagnosticMu.Unlock()
+	if QueueSnapshot(native) != nil {
+		t.Fatal("old endpoint retained after close")
+	}
+}
