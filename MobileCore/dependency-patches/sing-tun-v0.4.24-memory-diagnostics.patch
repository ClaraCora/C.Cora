index 0000000..90fc7e3
--- /dev/null
+++ b/internal/fdbased_darwin/memory_diagnostics.go
@@ -0,0 +1,30 @@
+package fdbased
+
+// QueueStats visits only waiting processor queues, not GRO or packets being
+// delivered. Processor queues are immutable in number after construction.
+func (e *endpoint) QueueStats() (int, uint64) {
+	var packets int
+	var bytes uint64
+	for _, dispatcher := range e.inboundDispatchers {
+		var manager *processorManager
+		switch d := dispatcher.(type) {
+		case *readVDispatcher:
+			manager = d.mgr
+		case *recvMMsgDispatcher:
+			manager = d.mgr
+		}
+		if manager == nil {
+			continue
+		}
+		for i := range manager.processors {
+			p := &manager.processors[i]
+			p.mu.Lock()
+			packets += p.pkts.Len()
+			for _, pkt := range p.pkts.AsSlice() {
+				bytes += uint64(pkt.Size())
+			}
+			p.mu.Unlock()
+		}
+	}
+	return packets, bytes
+}
diff --git a/internal/fdbased_darwin/memory_diagnostics_test.go b/internal/fdbased_darwin/memory_diagnostics_test.go
new file mode 100644
index 0000000..b842f56
--- /dev/null
+++ b/internal/fdbased_darwin/memory_diagnostics_test.go
@@ -0,0 +1,29 @@
+package fdbased
+
+import (
+	"testing"
+
+	"github.com/metacubex/gvisor/pkg/buffer"
+	"github.com/metacubex/gvisor/pkg/tcpip/stack"
+)
+
+func TestDiagnosticProcessorQueues(t *testing.T) {
+	manager := &processorManager{processors: make([]processor, 1)}
+	p := &manager.processors[0]
+	p.pkts.PushBack(stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(make([]byte, 71))}))
+	p.pkts.PushBack(stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(make([]byte, 19))}))
+	ep := &endpoint{inboundDispatchers: []linkDispatcher{&readVDispatcher{mgr: manager}}}
+	if packets, bytes := ep.QueueStats(); packets != 2 || bytes != 90 {
+		t.Fatalf("queue %d/%d", packets, bytes)
+	}
+	first := p.pkts.PopFront()
+	defer first.DecRef()
+	if first.Size() != 71 {
+		t.Fatal("diagnostic reordered packets")
+	}
+	// PopFront transfers ownership; use a fresh drain for the remaining packet.
+	p.pkts.Reset()
+	if packets, bytes := ep.QueueStats(); packets != 0 || bytes != 0 {
+		t.Fatal("stale processor stats")
+	}
+}
