+++ b/component/resolver/runtime_test.go
@@ -0,0 +1,136 @@
+package resolver
+
+import (
+	"context"
+	"net/netip"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	D "github.com/miekg/dns"
+)
+
+type runtimeTestResolver struct {
+	ip netip.Addr
+}
+
+func (r *runtimeTestResolver) LookupIP(context.Context, string) ([]netip.Addr, error) {
+	return []netip.Addr{r.ip}, nil
+}
+
+func (r *runtimeTestResolver) LookupIPv4(ctx context.Context, host string) ([]netip.Addr, error) {
+	return r.LookupIP(ctx, host)
+}
+
+func (r *runtimeTestResolver) LookupIPv6(ctx context.Context, host string) ([]netip.Addr, error) {
+	return r.LookupIP(ctx, host)
+}
+
+func (r *runtimeTestResolver) ResolveECH(context.Context, string) ([]byte, error) {
+	return nil, nil
+}
+
+func (r *runtimeTestResolver) ExchangeContext(context.Context, *D.Msg) (*D.Msg, error) {
+	return new(D.Msg), nil
+}
+
+func (*runtimeTestResolver) Invalid() bool    { return true }
+func (*runtimeTestResolver) ClearCache()      {}
+func (*runtimeTestResolver) ResetConnection() {}
+
+type runtimeTestService struct{}
+
+func (*runtimeTestService) ServeMsg(context.Context, *D.Msg) (*D.Msg, error) {
+	return new(D.Msg), nil
+}
+
+func preserveDNSRuntime(t *testing.T) {
+	t.Helper()
+	previous := CurrentDNSRuntime()
+	t.Cleanup(func() { PublishDNSRuntime(previous) })
+}
+
+func TestPublishDNSRuntimeCopiesInputAndProxiesLatestResolver(t *testing.T) {
+	preserveDNSRuntime(t)
+	first := &runtimeTestResolver{ip: netip.MustParseAddr("192.0.2.1")}
+	next := DNSRuntimeSnapshot{DefaultResolver: first}
+	PublishDNSRuntime(next)
+	next.DefaultResolver = nil
+
+	if CurrentDNSRuntime().DefaultResolver != first {
+		t.Fatal("published runtime changed when the caller mutated its input")
+	}
+	ips, err := DefaultResolver.LookupIP(context.Background(), "example.com")
+	if err != nil || len(ips) != 1 || ips[0] != first.ip {
+		t.Fatalf("stable proxy result = %v, %v; want %s", ips, err, first.ip)
+	}
+}
+
+func TestDNSRuntimePublicationNeverExposesMixedGeneration(t *testing.T) {
+	preserveDNSRuntime(t)
+	aDefault := &runtimeTestResolver{ip: netip.MustParseAddr("192.0.2.1")}
+	aProxy := &runtimeTestResolver{ip: netip.MustParseAddr("192.0.2.2")}
+	aDirect := &runtimeTestResolver{ip: netip.MustParseAddr("192.0.2.3")}
+	aService := &runtimeTestService{}
+	bDefault := &runtimeTestResolver{ip: netip.MustParseAddr("198.51.100.1")}
+	bProxy := &runtimeTestResolver{ip: netip.MustParseAddr("198.51.100.2")}
+	bDirect := &runtimeTestResolver{ip: netip.MustParseAddr("198.51.100.3")}
+	bService := &runtimeTestService{}
+	a := DNSRuntimeSnapshot{
+		DefaultResolver: aDefault, ProxyServerHostResolver: aProxy,
+		DirectHostResolver: aDirect, DefaultService: aService,
+	}
+	b := DNSRuntimeSnapshot{
+		DefaultResolver: bDefault, ProxyServerHostResolver: bProxy,
+		DirectHostResolver: bDirect, DefaultService: bService,
+		UseSystemHosts: true,
+	}
+	PublishDNSRuntime(a)
+
+	var mixed atomic.Bool
+	var group sync.WaitGroup
+	group.Add(5)
+	go func() {
+		defer group.Done()
+		for i := 0; i < 20000; i++ {
+			PublishDNSRuntime(a)
+			PublishDNSRuntime(b)
+		}
+	}()
+	for reader := 0; reader < 4; reader++ {
+		go func() {
+			defer group.Done()
+			for i := 0; i < 50000; i++ {
+				runtime := CurrentDNSRuntime()
+				isA := runtime.DefaultResolver == aDefault &&
+					runtime.ProxyServerHostResolver == aProxy &&
+					runtime.DirectHostResolver == aDirect &&
+					runtime.DefaultService == aService && !runtime.UseSystemHosts
+				isB := runtime.DefaultResolver == bDefault &&
+					runtime.ProxyServerHostResolver == bProxy &&
+					runtime.DirectHostResolver == bDirect &&
+					runtime.DefaultService == bService && runtime.UseSystemHosts
+				if !isA && !isB {
+					mixed.Store(true)
+					return
+				}
+			}
+		}()
+	}
+	group.Wait()
+	if mixed.Load() {
+		t.Fatal("a reader observed fields from different DNS runtime generations")
+	}
+}
+
+var runtimeSnapshotSink DNSRuntimeSnapshot
+
+func TestCurrentDNSRuntimeDoesNotAllocate(t *testing.T) {
+	preserveDNSRuntime(t)
+	PublishDNSRuntime(DNSRuntimeSnapshot{})
+	if allocs := testing.AllocsPerRun(1000, func() {
+		runtimeSnapshotSink = CurrentDNSRuntime()
+	}); allocs != 0 {
+		t.Fatalf("CurrentDNSRuntime allocations = %v, want 0", allocs)
+	}
+}
