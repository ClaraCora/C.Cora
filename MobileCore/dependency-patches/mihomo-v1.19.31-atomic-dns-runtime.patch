diff --git a/component/resolver/runtime.go b/component/resolver/runtime.go
new file mode 100644
index 0000000..49799ca
--- /dev/null
+++ b/component/resolver/runtime.go
@@ -0,0 +1,39 @@
+package resolver
+
+import "sync/atomic"
+
+// DNSRuntimeSnapshot is the complete resolver state used by the data plane.
+// Published snapshots are immutable and may be retained by concurrent readers.
+type DNSRuntimeSnapshot struct {
+	DefaultResolver         Resolver
+	ProxyServerHostResolver Resolver
+	DirectHostResolver      Resolver
+	DefaultService          Service
+	UseSystemHosts          bool
+}
+
+var (
+	emptyDNSRuntime DNSRuntimeSnapshot
+	dnsRuntime      atomic.Pointer[DNSRuntimeSnapshot]
+)
+
+func loadDNSRuntime() *DNSRuntimeSnapshot {
+	if runtime := dnsRuntime.Load(); runtime != nil {
+		return runtime
+	}
+	return &emptyDNSRuntime
+}
+
+// CurrentDNSRuntime returns a copy of one coherent DNS runtime generation.
+// Callers that need more than one field should retain the returned value for
+// the whole operation instead of loading the snapshot again.
+func CurrentDNSRuntime() DNSRuntimeSnapshot {
+	return *loadDNSRuntime()
+}
+
+// PublishDNSRuntime atomically replaces every resolver role and its related
+// service/hosts setting. The copy prevents later caller mutations from
+// changing a snapshot already visible to the data plane.
+func PublishDNSRuntime(runtime DNSRuntimeSnapshot) {
+	dnsRuntime.Store(&runtime)
+}
