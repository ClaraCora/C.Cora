--- /dev/null
+++ b/component/fakeip/memory_diagnostics.go
@@ -0,0 +1,18 @@
+package fakeip
+
+// CacheStats reports logical reverse mappings, not both direction indexes.
+// Persistent storage is deliberately not scanned during a diagnostic sample.
+type CacheStats struct {
+	Storage string `json:"storage"`
+	Entries *int   `json:"entries,omitempty"`
+}
+
+func (p *Pool) CacheStats() CacheStats {
+	p.mux.Lock()
+	defer p.mux.Unlock()
+	if memory, ok := p.store.(*memoryStore); ok {
+		entries := memory.cacheHost.Len()
+		return CacheStats{Storage: "memory", Entries: &entries}
+	}
+	return CacheStats{Storage: "persistent"}
+}
