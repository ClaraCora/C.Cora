+package listener
+
+import "github.com/metacubex/sing-tun"
+
+// TunQueueSnapshot serializes against TUN replacement. It never captures the
+// endpoint in a global registry, nor changes queue sizes or packet processing.
+func TunQueueSnapshot() *tun.QueueStats {
+	tunMux.Lock()
+	defer tunMux.Unlock()
+	if tunLister == nil {
+		return nil
+	}
+	return tunLister.QueueSnapshot()
+}
