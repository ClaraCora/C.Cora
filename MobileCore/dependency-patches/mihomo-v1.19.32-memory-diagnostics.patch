@@ -0,0 +1,34 @@
+package provider
+
+import (
+	"sync"
+	"testing"
+
+	P "github.com/metacubex/mihomo/constant/provider"
+)
+
+func TestDiagnosticProviderCount(t *testing.T) {
+	provider := NewInlineProvider("diagnostic", P.Domain, []string{"example.com", "example.org"}, nil)
+	count, ok := provider.(interface{ DiagnosticRuleCount() int })
+	if !ok || count.DiagnosticRuleCount() != provider.Count() || count.DiagnosticRuleCount() != 2 {
+		t.Fatal("inline count not published")
+	}
+	var bp baseProvider
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 10000; i++ {
+			// The updater owns strategy publication. Diagnostic readers never
+			// access this interface while a provider update swaps it.
+			bp.strategy = NewDomainStrategy()
+			bp.diagnosticCount.Store(int64(i))
+		}
+	}()
+	for i := 0; i < 10000; i++ {
+		if value := bp.DiagnosticRuleCount(); value < 0 || value > 9999 {
+			t.Fatalf("invalid count %d", value)
+		}
+	}
+	wg.Wait()
+}
