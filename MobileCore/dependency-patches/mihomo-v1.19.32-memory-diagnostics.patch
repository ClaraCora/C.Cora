+package lru
+
+// Len returns retained entries, including expired entries not yet evicted.
+// It does not refresh TTLs, access order, or invoke eviction callbacks.
+func (c *LruCache[K, V]) Len() int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return len(c.cache)
+}
