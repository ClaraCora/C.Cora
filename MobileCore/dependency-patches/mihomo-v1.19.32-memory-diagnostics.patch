--- /dev/null
+++ b/dns/memory_diagnostics_test.go
@@ -0,0 +1,31 @@
+package dns
+
+import (
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/common/arc"
+	"github.com/metacubex/mihomo/common/lru"
+	D "github.com/miekg/dns"
+)
+
+func TestDiagnosticResolverCachesDeduplicateBootstrap(t *testing.T) {
+	bootstrap := &Resolver{cache: lru.New[string, *D.Msg]()}
+	primary := &Resolver{cache: lru.New[string, *D.Msg](), defaultResolver: bootstrap}
+	direct := &Resolver{cache: arc.New[string, *D.Msg](arc.WithSize[string, *D.Msg](1)), defaultResolver: bootstrap}
+	primary.cache.SetWithExpire("primary", new(D.Msg), time.Now().Add(time.Hour))
+	bootstrap.cache.SetWithExpire("bootstrap", new(D.Msg), time.Now().Add(time.Hour))
+	direct.cache.SetWithExpire("ghost", new(D.Msg), time.Now().Add(time.Hour))
+	direct.cache.SetWithExpire("live", new(D.Msg), time.Now().Add(time.Hour))
+	if entries, caches := CacheEntries(primary, primary, direct, bootstrap, nil); entries != 3 || caches != 3 {
+		t.Fatalf("entries=%d caches=%d, want 3/3 (exclude duplicates/ARC ghosts)", entries, caches)
+	}
+	// Even a malformed diagnostic resolver cycle must terminate.
+	bootstrap.defaultResolver = primary
+	if entries, caches := CacheEntries(primary); entries != 2 || caches != 2 {
+		t.Fatalf("cycle: %d/%d", entries, caches)
+	}
+	if entries, caches := CacheEntries(); entries != 0 || caches != 0 {
+		t.Fatal("empty resolver stats")
+	}
+}
