+package fakeip
+
+import (
+	"net/netip"
+	"testing"
+)
+
+func TestDiagnosticCacheStats(t *testing.T) {
+	p, err := New(Options{IPNet: netip.MustParsePrefix("198.18.0.0/24"), Size: 16})
+	if err != nil {
+		t.Fatal(err)
+	}
+	address := p.Lookup("example.com")
+	p.Lookup("example.com")
+	stats := p.CacheStats()
+	if stats.Storage != "memory" || stats.Entries == nil || *stats.Entries != 1 {
+		t.Fatalf("double counted mapping: %+v", stats)
+	}
+	if host, ok := p.LookBack(address); !ok || host != "example.com" {
+		t.Fatal("sample affected mapping")
+	}
+	disk := &Pool{store: &cachefileStore{}}
+	if stats := disk.CacheStats(); stats.Storage != "persistent" || stats.Entries != nil {
+		t.Fatalf("persistent count invented: %+v", stats)
+	}
+}
diff --git a/dns/memory_diagnostics.go b/dns/memory_diagnostics.go
new file mode 100644
index 0000000..94bdcec
--- /dev/null
+++ b/dns/memory_diagnostics.go
@@ -0,0 +1,51 @@
+package dns
+
+import "github.com/metacubex/mihomo/component/fakeip"
+
+// CacheEntries sums only distinct resolver caches, including shared bootstrap
+// resolvers once. No DNS lookup, eviction, or TTL refresh is performed.
+func CacheEntries(resolvers ...*Resolver) (int, int) {
+	seen := make(map[*Resolver]struct{}, len(resolvers)+1)
+	entries, caches := 0, 0
+	var visit func(*Resolver)
+	visit = func(r *Resolver) {
+		if r == nil {
+			return
+		}
+		if _, exists := seen[r]; exists {
+			return
+		}
+		seen[r] = struct{}{}
+		if cache, ok := r.cache.(interface{ Len() int }); ok {
+			entries += cache.Len()
+			caches++
+		}
+		visit(r.defaultResolver)
+	}
+	for _, r := range resolvers {
+		visit(r)
+	}
+	return entries, caches
+}
+
+type EnhancerCacheStats struct {
+	MappingEntries int                `json:"dnsMappingEntries"`
+	FakeIP4        *fakeip.CacheStats `json:"fakeIP4,omitempty"`
+	FakeIP6        *fakeip.CacheStats `json:"fakeIP6,omitempty"`
+}
+
+func (h *ResolverEnhancer) CacheStats() EnhancerCacheStats {
+	var stats EnhancerCacheStats
+	if h.mapping != nil {
+		stats.MappingEntries = h.mapping.Len()
+	}
+	if h.fakeIPPool != nil {
+		snapshot := h.fakeIPPool.CacheStats()
+		stats.FakeIP4 = &snapshot
+	}
+	if h.fakeIPPool6 != nil {
+		snapshot := h.fakeIPPool6.CacheStats()
+		stats.FakeIP6 = &snapshot
+	}
+	return stats
+}
diff --git a/dns/memory_diagnostics_test.go b/dns/memory_diagnostics_test.go
new file mode 100644
