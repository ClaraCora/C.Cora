+const maxProcessorQueueBytes = 512 * 1024
+
 // +stateify savable
 type processor struct {
 	mu processorMutex `state:"nosave"`
 	// +checklocks:mu
 	pkts stack.PacketBufferList
 
-	e           *endpoint
-	gro         gro.GRO
