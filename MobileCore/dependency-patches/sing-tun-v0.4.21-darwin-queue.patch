new file mode 100644
index 0000000..115c82f
--- /dev/null
+++ b/internal/fdbased_darwin/processors_test.go
@@ -0,0 +1,37 @@
+package fdbased
+
+import (
+	"testing"
+
+	"github.com/metacubex/gvisor/pkg/tcpip/stack"
+)
+
+func TestProcessorQueueLimit(t *testing.T) {
+	const mtu = 1500
+	want := maxProcessorQueueBytes/mtu + 1
+	if got := processorQueueLimit(mtu); got != want {
+		t.Fatalf("processorQueueLimit(%d) = %d, want %d", mtu, got, want)
+	}
+	if got := processorQueueLimit(0); got != 1 {
+		t.Fatalf("processorQueueLimit(0) = %d, want 1", got)
+	}
+}
+
+func TestProcessorQueueIsBounded(t *testing.T) {
+	p := processor{maxQueuedPackets: 2}
+	defer p.pkts.Reset()
+
+	for i := 0; i < 3; i++ {
+		pkt := stack.NewPacketBuffer(stack.PacketBufferOptions{})
+		queued := p.enqueue(pkt)
+		pkt.DecRef()
+		wantQueued := i < p.maxQueuedPackets
+		if queued != wantQueued {
+			t.Fatalf("enqueue packet %d = %v, want %v", i, queued, wantQueued)
+		}
+	}
+
+	if got := p.pkts.Len(); got != p.maxQueuedPackets {
+		t.Fatalf("queued packets = %d, want %d", got, p.maxQueuedPackets)
+	}
+}
