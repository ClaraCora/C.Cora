+const maxProcessorQueueBytes = 512 * 1024
+
 // +stateify savable
 type processor struct {
 	mu processorMutex `state:"nosave"`
 	// +checklocks:mu
 	pkts stack.PacketBufferList
 
-	e           *endpoint
-	gro         gro.GRO
-	sleeper     sleep.Sleeper
-	packetWaker sleep.Waker
-	closeWaker  sleep.Waker
+	maxQueuedPackets int `state:"nosave"`
+	e                *endpoint
+	gro              gro.GRO
+	sleeper          sleep.Sleeper
+	packetWaker      sleep.Waker
+	closeWaker       sleep.Waker
+}
+
+func processorQueueLimit(mtu uint32) int {
+	if mtu == 0 {
+		return 1
+	}
+	return maxProcessorQueueBytes/int(mtu) + 1
+}
+
+// enqueue bounds the asynchronous Darwin packet queue. When the consumer is
+// delayed, dropping at this boundary lets TCP apply backpressure/retransmit
+// instead of allowing the Network Extension process to run out of memory.
+func (p *processor) enqueue(pkt *stack.PacketBuffer) bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.pkts.Len() >= p.maxQueuedPackets {
+		return false
+	}
+	p.pkts.PushBack(pkt.IncRef())
+	return true
 }
 
