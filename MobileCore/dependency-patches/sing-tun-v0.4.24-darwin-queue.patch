diff --git a/tun_darwin_gvisor_test.go b/tun_darwin_gvisor_test.go
new file mode 100644
--- /dev/null
+++ b/tun_darwin_gvisor_test.go
@@ -0,0 +1,20 @@
+//go:build with_gvisor && darwin
+
+package tun
+
+import "testing"
+
+func TestDarwinGVisorMemoryBounds(t *testing.T) {
+	if got, want := darwinGVisorProcessorsPerChannel, 1; got != want {
+		t.Fatalf("processors per channel = %d, want %d", got, want)
+	}
+	if got, want := darwinGVisorQDiscQueueLen, 128; got != want {
+		t.Fatalf("qdisc queue length = %d, want %d", got, want)
+	}
+}
+
+func TestDarwinGVisorBoundsArePositive(t *testing.T) {
+	if darwinGVisorProcessorsPerChannel <= 0 || darwinGVisorQDiscQueueLen <= 0 {
+		t.Fatal("Darwin gVisor memory bounds must remain positive")
+	}
+}
