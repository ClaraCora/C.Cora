+package executor
+
+import (
+	"errors"
+	"strings"
+	"testing"
+
+	P "github.com/metacubex/mihomo/constant/provider"
+)
+
+type runtimeTestProvider struct{ err error }
+
+type runtimeTestPanicProvider struct{ runtimeTestProvider }
+
+func (runtimeTestPanicProvider) Initial() error { panic("invalid provider") }
+
+func (p runtimeTestProvider) Name() string               { return "failed-start" }
+func (p runtimeTestProvider) VehicleType() P.VehicleType { return P.File }
+func (p runtimeTestProvider) Type() P.ProviderType       { return P.Rule }
+func (p runtimeTestProvider) Initial() error             { return p.err }
+func (p runtimeTestProvider) Update() error              { return nil }
+
+func TestRuntimeProviderInitializationError(t *testing.T) {
+	failure := errors.New("provider could not load")
+	err := loadProvider(map[string]P.Provider{"test": runtimeTestProvider{err: failure}})
+	if !errors.Is(err, failure) {
+		t.Fatalf("initialization failure lost: %v", err)
+	}
+	if err := loadProvider(map[string]P.Provider{"test": runtimeTestProvider{}}); err != nil {
+		t.Fatalf("successful initialization failed: %v", err)
+	}
+	if err := loadProvider(map[string]P.Provider{"test": runtimeTestPanicProvider{}}); err == nil || !strings.Contains(err.Error(), "invalid provider") {
+		t.Fatalf("background initialization panic not reported for rollback: %v", err)
+	}
+}
