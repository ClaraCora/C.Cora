+++ b/adapter/provider/runtime_lifecycle_test.go
@@ -0,0 +1,30 @@
+package provider
+
+import (
+	"testing"
+	"time"
+)
+
+func TestRuntimeHealthCheck100Cycles(t *testing.T) {
+	for cycle := 0; cycle < 100; cycle++ {
+		hc := NewHealthCheck(nil, "https://example.invalid", 100, 1, true, nil)
+		done := make(chan struct{})
+		go func() { hc.process(); close(done) }()
+		hc.setProxies(nil)
+		hc.registerHealthCheckTask("https://extra.invalid", nil, "test", 1)
+		hc.check()
+		hc.close()
+		hc.close()
+		if !hc.tasks.Wait(time.Now().Add(time.Second)) {
+			t.Fatal("health-check tasks did not drain")
+		}
+		select {
+		case <-done:
+		case <-time.After(time.Second):
+			t.Fatal("health-check loop retained after cancellation")
+		}
+		// A late check or process start from the previous session is rejected.
+		hc.check()
+		hc.process()
+	}
+}
diff --git a/component/resource/runtime_lifecycle_test.go b/component/resource/runtime_lifecycle_test.go
new file mode 100644
--- /dev/null
+++ b/component/resource/runtime_lifecycle_test.go
@@ -0,0 +1,132 @@
+package resource
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/common/utils"
+	P "github.com/metacubex/mihomo/constant/provider"
+)
+
+type blockingVehicle struct {
+	started chan struct{}
+	once    sync.Once
+	reads   atomic.Int32
+}
+
+func (v *blockingVehicle) Type() P.VehicleType { return P.HTTP }
+func (v *blockingVehicle) Path() string        { return "" }
+func (v *blockingVehicle) Url() string         { return "https://example.invalid" }
+func (v *blockingVehicle) Proxy() string       { return "" }
+func (v *blockingVehicle) Write([]byte) error  { return nil }
+func (v *blockingVehicle) Read(ctx context.Context, hash utils.HashType) ([]byte, utils.HashType, error) {
+	v.reads.Add(1)
+	v.once.Do(func() { close(v.started) })
+	<-ctx.Done()
+	return nil, hash, ctx.Err()
+}
+func TestRuntimeCancelRefreshAndPullLoop100Cycles(t *testing.T) {
+	for cycle := 0; cycle < 100; cycle++ {
+		vehicle := &blockingVehicle{started: make(chan struct{})}
+		var writes atomic.Int32
+		fetcher := NewFetcher("test", time.Hour, vehicle, nil, func(data []byte) (int, error) { return len(data), nil }, func(int) { writes.Add(1) })
+		done := make(chan struct{})
+		go func() { defer close(done); _, _ = fetcher.Initial() }()
+		select {
+		case <-vehicle.started:
+		case <-time.After(time.Second):
+			t.Fatal("download did not start")
+		}
+		if fetcher.DiagnosticRefreshActive() != 1 {
+			t.Fatal("active provider refresh was not accounted")
+		}
+		fetcher.CancelRuntime()
+		if !fetcher.WaitRuntimeIdle(time.Now().Add(time.Second)) {
+			t.Fatal("refresh retained worker")
+		}
+		<-done
+		if fetcher.DiagnosticRefreshActive() != 0 {
+			t.Fatal("provider refresh accounting did not return to baseline")
+		}
+		if err := fetcher.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if err := fetcher.Close(); err != nil {
+			t.Fatal(err)
+		}
+		_, _, err := fetcher.Update()
+		if !errors.Is(err, context.Canceled) || writes.Load() != 0 || vehicle.reads.Load() != 1 {
+			t.Fatal("cancelled provider was revived")
+		}
+	}
+}
+func TestRuntimeConcurrentRefreshSingleFlight(t *testing.T) {
+	vehicle := &blockingVehicle{started: make(chan struct{})}
+	fetcher := NewFetcher("test", time.Hour, vehicle, nil, func([]byte) (int, error) { return 1, nil }, nil)
+	var workers sync.WaitGroup
+	for i := 0; i < 12; i++ {
+		workers.Add(1)
+		go func() { defer workers.Done(); _, _, _ = fetcher.Update() }()
+	}
+	<-vehicle.started
+	fetcher.CancelRuntime()
+	if !fetcher.WaitRuntimeIdle(time.Now().Add(time.Second)) {
+		t.Fatal("concurrent refresh did not drain")
+	}
+	workers.Wait()
+	if vehicle.reads.Load() != 1 {
+		t.Fatalf("download fan-out: %d", vehicle.reads.Load())
+	}
+}
+func TestRuntimeTasksAdmissionAfterCancel(t *testing.T) {
+	var tasks RuntimeTasks
+	ctx, cancel := context.WithCancel(context.Background())
+	if !tasks.Begin(ctx) {
+		t.Fatal("initial admission failed")
+	}
+	if tasks.Wait(time.Now().Add(time.Millisecond)) {
+		t.Fatal("active task reported idle")
+	}
+	cancel()
+	if tasks.Begin(ctx) {
+		t.Fatal("admitted old session after cancellation")
+	}
+	tasks.End()
+	if !tasks.Wait(time.Now()) {
+		t.Fatal("idle worker retained")
+	}
+}
+
+type blockedWriteVehicle struct {
+	blockingVehicle
+	writing chan struct{}
+	release chan struct{}
+}
+
+func (v *blockedWriteVehicle) Write([]byte) error {
+	close(v.writing)
+	<-v.release
+	return nil
+}
+
+func TestRuntimeCancelDuringCacheWriteDoesNotPublish(t *testing.T) {
+	vehicle := &blockedWriteVehicle{writing: make(chan struct{}), release: make(chan struct{})}
+	var published atomic.Int32
+	fetcher := NewFetcher("test", time.Hour, vehicle, nil,
+		func([]byte) (int, error) { return 1, nil }, func(int) { published.Add(1) })
+	done := make(chan error, 1)
+	go func() { _, _, err := fetcher.SideUpdate([]byte("new rules")); done <- err }()
+	<-vehicle.writing
+	fetcher.CancelRuntime()
+	close(vehicle.release)
+	if err := <-done; !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancelled cache write returned %v", err)
+	}
+	if published.Load() != 0 || !fetcher.WaitRuntimeIdle(time.Now().Add(time.Second)) {
+		t.Fatal("cancelled cache write published into the runtime")
+	}
+}
diff --git a/component/resource/runtime_tasks.go b/component/resource/runtime_tasks.go
new file mode 100644
--- /dev/null
+++ b/component/resource/runtime_tasks.go
@@ -0,0 +1,53 @@
+package resource
+
+import (
+	"context"
+	"sync"
+	"time"
+)
+
+// RuntimeTasks tracks control workers only. Admission and idle publication
+// share a lock so cancellation cannot race WaitGroup.Add and Wait.
+type RuntimeTasks struct {
+	mu     sync.Mutex
+	active int
+	idle   chan struct{}
+}
+
+func (t *RuntimeTasks) Begin(ctx context.Context) bool {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if ctx.Err() != nil {
+		return false
+	}
+	if t.active == 0 {
+		t.idle = make(chan struct{})
+	}
+	t.active++
+	return true
+}
+func (t *RuntimeTasks) End() {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.active--
+	if t.active == 0 {
+		close(t.idle)
+	}
+}
+func (t *RuntimeTasks) Wait(deadline time.Time) bool {
+	t.mu.Lock()
+	if t.active == 0 {
+		t.mu.Unlock()
+		return true
+	}
+	idle := t.idle
+	t.mu.Unlock()
+	timer := time.NewTimer(time.Until(deadline))
+	defer timer.Stop()
+	select {
+	case <-idle:
+		return true
+	case <-timer.C:
+		return false
+	}
+}
