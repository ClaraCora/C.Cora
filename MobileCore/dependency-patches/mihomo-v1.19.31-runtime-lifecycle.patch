+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("read unexpectedly succeeded")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("cancel did not close NTP socket")
+	}
+	_ = conn.Close()
+}
